#!/usr/bin/env bash
# rah — Remote as Host
# Edit files via a same-path sshfs mount; execute commands on the remote via ssh.
# The agent's file tools hit the local mount; its Bash is rewritten (by a PreToolUse
# hook) to run on the remote — deterministically, with no model awareness.
set -euo pipefail

RAH_VERSION="0.1.1"
RAH_CONFIG_DIR="${RAH_CONFIG_DIR:-$HOME/.config/rah}"
RAH_REPO="${RAH_REPO:-Hiaa1/rah}"
RAH_RAW_URL="${RAH_RAW_URL:-https://raw.githubusercontent.com/$RAH_REPO/main/rah}"
RAH_BIN_DIR="${RAH_BIN_DIR:-$HOME/.local/bin}"

_self_path() { readlink -f "${BASH_SOURCE[0]}"; }

# ---------- helpers ----------

_die() { printf 'rah: %s\n' "$*" >&2; exit 1; }

# POSIX single-quote escaping for safe embedding in a remote shell string.
_shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Read one key from an env-style config file (no sourcing -> no code execution).
_get() { sed -n "s/^$2=//p" "$1" | head -n1; }

# Prompt the user via the terminal, even when stdin is a pipe (curl | bash).
_prompt() {
  local msg="$1" ans=""
  if [ -r /dev/tty ]; then printf '%s' "$msg" >/dev/tty; IFS= read -r ans </dev/tty || true; fi
  printf '%s' "$ans"
}

_list_configs() {
  [ -d "$RAH_CONFIG_DIR" ] || return 0
  local f
  for f in "$RAH_CONFIG_DIR"/*.env; do
    [ -e "$f" ] && printf '%s\n' "$f"
  done
}

# Print the config file whose mountpoint is a prefix of $1 (the cwd). Non-zero if none.
_config_for_cwd() {
  local cwd="$1" f mp
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    mp="$(_get "$f" mountpoint)"
    [ -n "$mp" ] || continue
    case "$cwd/" in
      "$mp"/*) printf '%s\n' "$f"; return 0 ;;
    esac
  done < <(_list_configs)
  return 1
}

# Fast, timeout-guarded liveness probe. A dead fuse mount hangs on access, so this
# must never run unguarded. Returns 0 if the path is reachable.
_mount_alive() { timeout 2 stat "$1" >/dev/null 2>&1; }

# Classify a mountpoint: mounted | dead | unmounted. `mountpoint -q` alone lies
# (a dead fuse mount still reports as mounted), so combine it with a liveness probe.
_mount_state() {
  local mp="$1"
  if timeout 3 mountpoint -q "$mp" 2>/dev/null; then
    _mount_alive "$mp" && echo mounted || echo dead
  elif timeout 3 stat "$mp" >/dev/null 2>&1; then
    echo unmounted
  else
    echo dead
  fi
}

# Passwordless ssh reachability probe (BatchMode: never blocks on a password prompt).
_ssh_ok() { ssh -o BatchMode=yes -o ConnectTimeout=5 "$1" true 2>/dev/null; }

# The skill document, emitted into each agent's skills dir by `rah init`.
_skill_doc() {
  cat <<'RAHSKILL'
---
name: rah
description: Remote as Host — manage the sshfs mount and remote execution for this machine. Use when the user asks to mount/unmount a remote project, set up "remote as host", check mount/ssh health (rah status), or recover a broken mount. Note that command execution in a rah-managed directory is ALREADY auto-routed to the remote by a hook — you do not need to add ssh yourself.
---

# rah — Remote as Host

`rah` lets this host act as a remote dev box: files are edited through a same-path
sshfs mount, while command execution is transparently routed to the remote over ssh
by a `PreToolUse` hook. **You do not need to prefix commands with `ssh` or do anything
special — when the working directory is a rah-managed mount, your normal Bash commands
already run on the remote (with its GPU, datasets, and environment).**

## When to use this skill

Only for **control-plane** actions: setting up, mounting, checking health, or recovering.
Execution routing is automatic; never wrap commands in ssh manually.

## Commands

- `rah setup [user@host:/abs/path]` — one-command onboarding: checks dependencies, wires the
  installed agents, and mounts. When helping a user set this up, ask them **only** for the host
  and the absolute remote path; everything else (agents, deps, env prelude) is auto-detected.
- `rah status` — list managed mounts; show mounted / DEAD / not-mounted and ssh-master health.
- `rah mount [--name N] [--prelude 'CMD'] user@host:/abs/path` — mount a remote code tree at the
  identical absolute path. `--prelude` is a shell snippet run before each remote command
  (e.g. `source .venv/bin/activate`) to fix the remote environment.
- `rah remount [name]` — recover a dead/stale mount (re-establishes ssh + sshfs). No name = all.
- `rah unmount <name>` — unmount and drop the ssh master connection.
- `rah init <claude|codex>` — install the routing hook and this skill for an agent.

## Recovery

If file tools fail with `Transport endpoint is not connected` or hang, the mount has died. Run
`rah remount` (it executes locally) and retry. Command execution over ssh keeps working even
while the mount is down, since it is a separate channel.

## Notes

- Only the **code tree** is mounted; datasets/outputs stay on the remote and are reached
  natively when commands execute there. Don't try to read large datasets through the mount.
- If a command must inspect remote outputs/logs, just run `cat`/`ls`/`tail` normally — it
  executes on the remote.
- `cd` within the mount works locally and is preserved across commands; everything else runs remote.
RAHSKILL
}

# ---------- mount internals ----------

# Ensure a persistent ssh master connection at $socket. Returns non-zero on failure.
_ensure_master() {
  local host="$1" socket="$2"
  ssh -S "$socket" -O check "$host" 2>/dev/null && return 0
  ssh -M -S "$socket" -o ControlPersist=600 -fN "$host"
}

# Mount remote_path at mp (same path). Re-establishes master, clears a stale mount,
# and skips work if already healthy. Returns sshfs's status.
_do_mount() {
  local host="$1" remote_path="$2" mp="$3" socket="$4"
  _ensure_master "$host" "$socket" || return 1
  if timeout 3 mountpoint -q "$mp" 2>/dev/null; then
    _mount_alive "$mp" && return 0               # already mounted & healthy
    fusermount -uz "$mp" 2>/dev/null || true     # stale -> clear before remount
  fi
  sshfs "$host:$remote_path" "$mp" \
    -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,follow_symlinks,ControlPath="$socket"
}

# ---------- mount ----------

cmd_mount() {
  local name="" prelude="" target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)    name="$2"; shift 2 ;;
      --prelude) prelude="$2"; shift 2 ;;
      --*)       _die "unknown option: $1" ;;
      *)         target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || _die "usage: rah mount [--name N] [--prelude CMD] user@host:/abs/path"

  local host="${target%%:*}" remote_path="${target#*:}"
  case "$remote_path" in /*) ;; *) _die "remote path must be absolute: $remote_path" ;; esac
  [ -n "$name" ] || name="$(printf '%s' "${host##*@}_${remote_path##*/}" | tr -c 'A-Za-z0-9_.-' '_')"

  local mountpoint="$remote_path"                 # same-path: no translation
  local socket="$HOME/.ssh/cm-${host##*@}"

  mkdir -p "$RAH_CONFIG_DIR"
  if ! mkdir -p "$mountpoint" 2>/dev/null; then
    _die "cannot create mountpoint $mountpoint. Run once:
  sudo mkdir -p $mountpoint && sudo chown $USER: $mountpoint"
  fi

  _do_mount "$host" "$remote_path" "$mountpoint" "$socket" || _die "mount failed (host $host)"

  local cfg="$RAH_CONFIG_DIR/$name.env"
  {
    printf 'host=%s\n'           "$host"
    printf 'remote_path=%s\n'    "$remote_path"
    printf 'mountpoint=%s\n'     "$mountpoint"
    printf 'control_socket=%s\n' "$socket"
    printf 'prelude=%s\n'        "$prelude"
  } > "$cfg"
  echo "rah: mounted $host:$remote_path at $mountpoint (config: $cfg)"
}

cmd_remount() {
  local names=() cfg name host remote_path mp socket
  if [ $# -gt 0 ]; then
    names=("$@")
  else
    while IFS= read -r cfg; do [ -n "$cfg" ] && names+=("$(basename "$cfg" .env)"); done < <(_list_configs)
  fi
  [ "${#names[@]}" -gt 0 ] || _die "no managed mounts to remount"
  for name in "${names[@]}"; do
    cfg="$RAH_CONFIG_DIR/$name.env"
    [ -f "$cfg" ] || { echo "rah: no such mount: $name" >&2; continue; }
    host="$(_get "$cfg" host)"; remote_path="$(_get "$cfg" remote_path)"
    mp="$(_get "$cfg" mountpoint)"; socket="$(_get "$cfg" control_socket)"
    fusermount -uz "$mp" 2>/dev/null || true
    if _do_mount "$host" "$remote_path" "$mp" "$socket"; then
      echo "rah: remounted $name ($mp)"
    else
      echo "rah: remount failed for $name" >&2
    fi
  done
}

cmd_unmount() {
  local name="${1:-}"
  [ -n "$name" ] || _die "usage: rah unmount <name>"
  local cfg="$RAH_CONFIG_DIR/$name.env"
  [ -f "$cfg" ] || _die "no such mount: $name"
  local mp host socket
  mp="$(_get "$cfg" mountpoint)"; host="$(_get "$cfg" host)"; socket="$(_get "$cfg" control_socket)"
  if timeout 3 mountpoint -q "$mp" 2>/dev/null; then
    fusermount -uz "$mp" || _die "fusermount failed for $mp"
  fi
  ssh -S "$socket" -O exit "$host" 2>/dev/null || true
  echo "rah: unmounted $name"
}

# ---------- run (routing core) ----------

cmd_run() {
  local cwd="" b64cmd=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd) cwd="$2"; shift 2 ;;
      --b64) b64cmd="$2"; shift 2 ;;
      --)    shift; break ;;
      *)     break ;;
    esac
  done
  local cmd
  if [ -n "$b64cmd" ]; then
    cmd="$(printf '%s' "$b64cmd" | base64 -d)"
  else
    cmd="$*"
  fi
  [ -n "$cmd" ] || _die "run: empty command"
  [ -n "$cwd" ] || cwd="$PWD"

  local cfg
  if ! cfg="$(_config_for_cwd "$cwd")"; then
    # Not under any managed mount -> run locally (safety fallthrough).
    bash -c "$cmd"; exit $?
  fi
  local host socket prelude
  host="$(_get "$cfg" host)"; socket="$(_get "$cfg" control_socket)"; prelude="$(_get "$cfg" prelude)"

  _ensure_master "$host" "$socket" 2>/dev/null || true   # self-heal a dead master

  local b64 pre=""
  b64="$(printf '%s' "$cmd" | base64 -w0)"
  [ -n "$prelude" ] && pre="{ $prelude; } && "

  local remote="cd $(_shq "$cwd") && ${pre}printf %s $(_shq "$b64") | base64 -d | bash"
  set +e
  ssh -S "$socket" "$host" "$remote"
  local rc=$?
  set -e
  exit $rc
}

# ---------- hook (PreToolUse rewrite; shared by Claude & Codex) ----------

cmd_hook() {
  set +e
  local decision="defer"
  while [ $# -gt 0 ]; do
    case "$1" in
      --decision) decision="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  case "$decision" in defer|allow|ask) ;; *) decision="defer" ;; esac

  local input cmd cwd
  input="$(cat)"
  cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null)"
  cwd="$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)"
  [ -n "$cwd" ] || cwd="$PWD"

  local passthrough=0 cfg=""
  cfg="$(_config_for_cwd "$cwd" 2>/dev/null)" || passthrough=1
  case "$cmd" in rah|"rah "*) passthrough=1 ;; esac

  # Opportunistic, throttled, non-blocking mount self-heal (file plane only).
  # Runs at most once per 10s; if the mount is dead, fire a detached remount and
  # continue — the command still routes over ssh, which is independent of the mount.
  if [ -n "$cfg" ]; then
    local _name _stamp
    _name="$(basename "$cfg" .env)"; _stamp="$RAH_CONFIG_DIR/.heal.$_name"
    if [ -z "$(find "$_stamp" -newermt '-10 seconds' 2>/dev/null)" ]; then
      : > "$_stamp" 2>/dev/null || true
      if ! _mount_alive "$(_get "$cfg" mountpoint)"; then
        if command -v setsid >/dev/null 2>&1; then
          setsid "$(_self_path)" remount "$_name" </dev/null >/dev/null 2>&1 &
        else
          nohup "$(_self_path)" remount "$_name" </dev/null >/dev/null 2>&1 &
        fi
      fi
    fi
  fi

  # Pure navigation (standalone cd/pushd/popd, no chaining) -> keep local to
  # preserve the agent's persistent shell cwd.
  local trimmed="${cmd#"${cmd%%[![:space:]]*}"}"
  case "$trimmed" in
    cd|cd\ *|pushd|pushd\ *|popd|popd\ *)
      case "$cmd" in
        *'&&'*|*';'*|*'|'*|*$'\n'*) : ;;
        *) passthrough=1 ;;
      esac ;;
  esac

  if [ "$passthrough" -eq 1 ] || [ -z "$cmd" ]; then
    jq -nc '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"defer"}}'
    return 0
  fi

  # Readable rewrite for commands the agent's local shell passes through verbatim;
  # fall back to base64 transport when shell metacharacters would be re-parsed.
  local newcmd
  case "$cmd" in
    *[!A-Za-z0-9\ _.,=/+:@%-]*)
      newcmd="rah run --cwd $(_shq "$cwd") --b64 $(printf '%s' "$cmd" | base64 -w0)" ;;
    *)
      newcmd="rah run --cwd $(_shq "$cwd") -- $cmd" ;;
  esac
  jq -nc --arg c "$newcmd" --arg d "$decision" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:$d,updatedInput:{command:$c}}}'
}

# ---------- init (install/remove hook + skill for an agent) ----------

_ensure_path() {
  mkdir -p "$RAH_BIN_DIR"
  local self target="$RAH_BIN_DIR/rah"; self="$(_self_path)"
  [ "$self" = "$target" ] || ln -sf "$self" "$target"
  case ":$PATH:" in
    *":$RAH_BIN_DIR:"*) ;;
    *) echo "rah: note — add $RAH_BIN_DIR to your PATH" ;;
  esac
}

# True if the rah hook is already registered in a JSON agent config file.
_hook_present() {
  local file="$1"
  [ -f "$file" ] || return 1
  jq -e '(.hooks.PreToolUse // []) | any(.[]; (.hooks // []) | any(.command == "rah hook"))' \
    "$file" >/dev/null 2>&1
}

# Add our {matcher:"Bash", hooks:[{command:"rah hook"}]} group to .hooks.PreToolUse, idempotently.
_merge_hook_json() {
  local file="$1" tmp; tmp="$(mktemp)"
  [ -f "$file" ] || echo '{}' > "$file"
  jq '
    .hooks.PreToolUse = ((.hooks.PreToolUse // [])
      | if any(.[]; (.hooks // []) | any(.command == "rah hook")) then .
        else . + [{matcher:"Bash", hooks:[{type:"command", command:"rah hook"}]}] end)
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

# Strip the rah hook entry from .hooks.PreToolUse, dropping any group left empty.
_remove_hook_json() {
  local file="$1" tmp
  [ -f "$file" ] || return 0
  tmp="$(mktemp)"
  jq '
    if (.hooks.PreToolUse | type) == "array" then
      .hooks.PreToolUse |= ( map(.hooks |= map(select(.command != "rah hook")))
                             | map(select((.hooks // [] | length) > 0)) )
    else . end
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

_init_agent() {
  local label="$1" home="$2" cfg="$3" skilldir="$4" remove="$5"
  if [ "$remove" -eq 1 ]; then
    _remove_hook_json "$cfg"
    rm -rf "$skilldir"
    echo "rah: removed $label hook + skill"
  else
    _ensure_path
    mkdir -p "$home" "$skilldir"
    _merge_hook_json "$cfg"
    _skill_doc > "$skilldir/SKILL.md"
    echo "rah: $label hook + skill installed ($home)"
  fi
}

cmd_init() {
  local agent="" remove=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --remove)     remove=1; shift ;;
      claude|codex) agent="$1"; shift ;;
      *)            _die "usage: rah init <claude|codex> [--remove]" ;;
    esac
  done
  case "$agent" in
    claude) _init_agent "Claude" "$HOME/.claude" "$HOME/.claude/settings.json" "$HOME/.claude/skills/rah" "$remove" ;;
    codex)  _init_agent "Codex"  "$HOME/.codex"  "$HOME/.codex/hooks.json"     "$HOME/.codex/skills/rah"  "$remove" ;;
    *)      _die "usage: rah init <claude|codex> [--remove]" ;;
  esac
}

# ---------- setup (one-command guided onboarding) ----------

cmd_setup() {
  local target="" prelude="" prelude_set=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --prelude) prelude="$2"; prelude_set=1; shift 2 ;;
      --*)       _die "unknown option: $1" ;;
      *)         target="$1"; shift ;;
    esac
  done

  echo "== rah setup =="
  cmd_doctor            # exits with apt hints if a required dependency is missing
  echo

  # Wire whichever agents are installed (idempotent); note if a hook was newly added.
  local a adir cfgfile newly=0
  for a in claude codex; do
    adir="$HOME/.$a"; [ -d "$adir" ] || continue
    cfgfile="$adir/settings.json"; [ "$a" = codex ] && cfgfile="$adir/hooks.json"
    _hook_present "$cfgfile" || newly=1
    cmd_init "$a" >/dev/null
    echo "agent: $a wired"
  done

  # Resolve the remote target (ask only for the irreducible input).
  [ -n "$target" ] || target="$(_prompt 'remote to mount (user@host:/abs/path): ')"
  [ -n "$target" ] || _die "no remote given"
  case "$target" in *:/*) ;; *) _die "expected user@host:/abs/path, got: $target" ;; esac
  local host="${target%%:*}" remote_path="${target#*:}"

  # SSH preflight — rah needs passwordless ssh; fail loud with the one human step.
  if ! _ssh_ok "$host"; then
    echo "rah: passwordless ssh to '$host' isn't working yet. Authorize your key once:"
    echo "    ssh-copy-id $host           # enter the remote password this one time"
    echo "  (or add a Host alias in ~/.ssh/config: HostName / User / Port / IdentityFile)"
    echo "  verify with: ssh $host true"
    echo "then re-run: rah setup $target"
    return 1
  fi

  # Same-path mountpoint — needs root once if it's outside your home.
  if ! mkdir -p "$remote_path" 2>/dev/null; then
    echo "rah: the mount path needs root to create once — run:"
    echo "  sudo mkdir -p $remote_path && sudo chown $USER: $remote_path"
    echo "then re-run: rah setup $target"
    return 1
  fi

  # Best-effort prelude auto-probe.
  if [ "$prelude_set" = 0 ]; then
    local socket="$HOME/.ssh/cm-${host##*@}"
    _ensure_master "$host" "$socket" 2>/dev/null || true
    if ssh -S "$socket" "$host" "test -f $(_shq "$remote_path/.venv/bin/activate")" 2>/dev/null; then
      prelude="source .venv/bin/activate"; echo "prelude: detected .venv -> '$prelude'"
    fi
  fi

  # Mount.
  if [ -n "$prelude" ]; then cmd_mount --prelude "$prelude" "$target"; else cmd_mount "$target"; fi

  echo
  if [ "$newly" = 1 ]; then
    echo "rah: hook newly installed — restart your agent ONCE so it loads."
    echo "     (future mounts activate immediately, no restart needed.)"
  else
    echo "rah: ready — routing is live now, no restart needed."
  fi
}

# ---------- status / doctor ----------

cmd_status() {
  local any=0 cfg name host mp socket
  while IFS= read -r cfg; do
    [ -n "$cfg" ] || continue
    any=1
    name="$(basename "$cfg" .env)"
    host="$(_get "$cfg" host)"; mp="$(_get "$cfg" mountpoint)"; socket="$(_get "$cfg" control_socket)"
    printf '● %s\n' "$name"
    printf '  host:       %s\n' "$host"
    printf '  mountpoint: %s ' "$mp"
    case "$(_mount_state "$mp")" in
      mounted) printf '[mounted]\n' ;;
      dead)    printf '[DEAD — run: rah remount %s]\n' "$name" ;;
      *)       printf '[not mounted]\n' ;;
    esac
    printf '  ssh:        '
    if _ssh_ok "$host"; then printf '[reachable]\n'; else printf '[NO passwordless ssh — run: ssh-copy-id %s]\n' "$host"; fi
  done < <(_list_configs)
  [ "$any" -eq 1 ] || echo "rah: no managed mounts (run: rah mount user@host:/abs/path)"
}

_check_dep() {  # name pkg required(0|1) ; prints status, returns non-zero if missing
  local bin="$1" pkg="$2" required="$3"
  printf '  %-12s ' "$bin"
  if command -v "$bin" >/dev/null 2>&1; then echo "[ok]"; return 0; fi
  [ "$required" -eq 1 ] && echo "[MISSING — apt install $pkg]" || echo "[optional — apt install $pkg]"
  return 1
}

cmd_doctor() {
  local ok=1
  echo "rah doctor (v$RAH_VERSION)"
  _check_dep ssh        openssh-client 1 || ok=0
  _check_dep sshfs      sshfs          1 || ok=0
  if command -v fusermount >/dev/null 2>&1 || command -v fusermount3 >/dev/null 2>&1; then
    printf '  %-12s [ok]\n' fusermount
  else
    printf '  %-12s [MISSING — apt install fuse3]\n' fusermount; ok=0
  fi
  _check_dep jq         jq             1 || ok=0
  _check_dep base64     coreutils      1 || ok=0
  _check_dep timeout    coreutils      1 || ok=0
  _check_dep mountpoint util-linux     1 || ok=0
  _check_dep curl       curl           0 || true
  printf '  %-12s ' PATH
  case ":$PATH:" in
    *":$RAH_BIN_DIR:"*) echo "[$RAH_BIN_DIR on PATH]" ;;
    *) echo "[$RAH_BIN_DIR NOT on PATH — add it]" ;;
  esac
  local any=0 cfg
  while IFS= read -r cfg; do [ -n "$cfg" ] && any=1; done < <(_list_configs)
  [ "$any" -eq 1 ] && { echo "  mounts:"; cmd_status | sed 's/^/    /'; }
  [ "$ok" -eq 1 ] && echo "rah: all required dependencies present" || _die "missing required dependencies (see above)"
}

# ---------- self-update / uninstall ----------

cmd_self_update() {
  command -v curl >/dev/null 2>&1 || _die "curl required for self-update"
  local dest tmp newver; dest="$(_self_path)"; tmp="$(mktemp)"
  echo "rah: fetching $RAH_RAW_URL"
  curl -fsSL "$RAH_RAW_URL" -o "$tmp" || { rm -f "$tmp"; _die "download failed"; }
  head -1 "$tmp" | grep -q '^#!/usr/bin/env bash' || { rm -f "$tmp"; _die "downloaded file does not look like rah"; }
  newver="$(sed -n 's/^RAH_VERSION="\(.*\)"/\1/p' "$tmp" | head -1)"
  [ -n "$newver" ] || { rm -f "$tmp"; _die "downloaded file missing version marker"; }
  chmod +x "$tmp"; mv "$tmp" "$dest"
  echo "rah: updated $dest ($RAH_VERSION -> $newver)"
}

cmd_uninstall() {
  local purge=0
  case "${1:-}" in --purge) purge=1 ;; "") ;; *) _die "usage: rah uninstall [--purge]" ;; esac
  local cfg name
  while IFS= read -r cfg; do
    [ -n "$cfg" ] || continue
    name="$(basename "$cfg" .env)"
    cmd_unmount "$name" 2>/dev/null || true
  done < <(_list_configs)
  _remove_hook_json "$HOME/.claude/settings.json"; rm -rf "$HOME/.claude/skills/rah"
  _remove_hook_json "$HOME/.codex/hooks.json";     rm -rf "$HOME/.codex/skills/rah"
  echo "rah: removed hooks + skills from ~/.claude and ~/.codex"
  [ -e "$RAH_BIN_DIR/rah" ] && { rm -f "$RAH_BIN_DIR/rah"; echo "rah: removed $RAH_BIN_DIR/rah"; }
  if [ "$purge" -eq 1 ]; then
    rm -rf "$RAH_CONFIG_DIR"; echo "rah: purged $RAH_CONFIG_DIR"
  else
    echo "rah: kept configs in $RAH_CONFIG_DIR (use --purge to remove)"
  fi
}

# ---------- dispatch ----------

_usage() {
  cat <<EOF
rah — Remote as Host (v$RAH_VERSION)

  rah setup [user@host:/abs/path] [--prelude CMD]            one-command guided onboarding
  rah mount [--name N] [--prelude CMD] user@host:/abs/path   mount remote code tree (same path)
  rah remount [name]                                         recover a dead mount (all if no name)
  rah unmount <name>                                         unmount + drop ssh master
  rah run --cwd <dir> -- <cmd...>                            execute a command on the remote
  rah hook [--decision defer|allow|ask]                      PreToolUse rewrite (reads JSON on stdin)
  rah init <claude|codex> [--remove]                         install/remove hook + skill for an agent
  rah status                                                 show mounts / ssh master health
  rah doctor                                                 check dependencies, PATH, mount health
  rah self-update                                            update rah to the latest version
  rah uninstall [--purge]                                    remove hooks, skill, and the rah binary
  rah version                                                print version
EOF
}

main() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$sub" in
    setup)       cmd_setup "$@" ;;
    mount)       cmd_mount "$@" ;;
    remount)     cmd_remount "$@" ;;
    unmount)     cmd_unmount "$@" ;;
    run)         cmd_run "$@" ;;
    hook)        cmd_hook "$@" ;;
    init)        cmd_init "$@" ;;
    status)      cmd_status "$@" ;;
    doctor)      cmd_doctor "$@" ;;
    self-update) cmd_self_update "$@" ;;
    uninstall)   cmd_uninstall "$@" ;;
    version|--version|-v) echo "rah $RAH_VERSION" ;;
    ""|-h|--help|help) _usage ;;
    *) _die "unknown subcommand: $sub (try: rah help)" ;;
  esac
}

main "$@"
