#!/usr/bin/env bash
# rah — Remote as Host
# Edit files via an sshfs mount; execute commands on the remote via ssh.
# The agent's file tools hit the local mount; its Bash is rewritten (by a PreToolUse
# hook) to run on the remote — deterministically, with no model awareness.
set -euo pipefail

RAH_VERSION="0.4.1"
RAH_CONFIG_DIR="${RAH_CONFIG_DIR:-$HOME/.config/rah}"
RAH_REPO="${RAH_REPO:-Hiaa1/rah}"
RAH_RAW_URL="${RAH_RAW_URL:-https://raw.githubusercontent.com/$RAH_REPO/main/rah}"
RAH_BIN_DIR="${RAH_BIN_DIR:-$HOME/.local/bin}"
RAH_MOUNT_ROOT="${RAH_MOUNT_ROOT:-$HOME/mnt_rah}"
RAH_HOOK_LOG_DEFAULT="$RAH_CONFIG_DIR/hook.jsonl"
RAH_HOOK_LOG_FLAG="$RAH_CONFIG_DIR/hook-log"
RAH_UNAME="$(uname -s 2>/dev/null || echo unknown)"

_is_macos() { [ "$RAH_UNAME" = Darwin ]; }

# Required runtime dependencies as bin:package-hint.
if _is_macos; then
  RAH_DEPS=(ssh:openssh sshfs:sshfs jq:jq base64:coreutils perl:perl)
else
  RAH_DEPS=(ssh:openssh-client sshfs:sshfs jq:jq base64:coreutils timeout:coreutils mountpoint:util-linux)
fi

_self_path() {
  local src="${BASH_SOURCE[0]}" dir found
  if [ "${src%/*}" = "$src" ]; then
    found="$(command -v -- "$src" 2>/dev/null || true)"
    [ -n "$found" ] && src="$found"
  fi
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd -P)" || return 1
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  dir="$(cd -P "$(dirname "$src")" && pwd -P)" || return 1
  printf '%s/%s\n' "$dir" "$(basename "$src")"
}

# ---------- helpers ----------

_color_enabled() {
  case "${RAH_COLOR:-auto}" in
    always) return 0 ;;
    never|0|false|False|FALSE|off|OFF|no|NO) return 1 ;;
    *)
      [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ] ;;
  esac
}

if _color_enabled; then
  RAH_RESET=$'\033[0m'
  RAH_BOLD=$'\033[1m'
  RAH_DIM=$'\033[2m'
  RAH_RED=$'\033[31m'
  RAH_GREEN=$'\033[32m'
  RAH_YELLOW=$'\033[33m'
  RAH_BLUE=$'\033[34m'
  RAH_CYAN=$'\033[36m'
else
  RAH_RESET=""; RAH_BOLD=""; RAH_DIM=""; RAH_RED=""
  RAH_GREEN=""; RAH_YELLOW=""; RAH_BLUE=""; RAH_CYAN=""
fi

_say_header() { printf '%b\n' "${RAH_BOLD}${RAH_BLUE}==> $*${RAH_RESET}"; }
_say_ok() { printf '%b\n' "  ${RAH_GREEN}[ok]${RAH_RESET} $*"; }
_say_warn() { printf '%b\n' "  ${RAH_YELLOW}[warn]${RAH_RESET} $*"; }
_say_fail() { printf '%b\n' "  ${RAH_RED}[fail]${RAH_RESET} $*"; }
_say_note() { printf '%b\n' "  ${RAH_DIM}$*${RAH_RESET}"; }
_say_cmd() { printf '%b\n' "  ${RAH_CYAN}$*${RAH_RESET}"; }
_tag_ok() { printf '%b' "${RAH_GREEN}[$*]${RAH_RESET}"; }
_tag_warn() { printf '%b' "${RAH_YELLOW}[$*]${RAH_RESET}"; }
_tag_fail() { printf '%b' "${RAH_RED}[$*]${RAH_RESET}"; }
_tag_note() { printf '%b' "${RAH_DIM}[$*]${RAH_RESET}"; }

_die() { printf '%b\n' "${RAH_RED}rah: error:${RAH_RESET} $*" >&2; exit 1; }

_lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

_trim_leading_ws() {
  local s="$1"
  printf '%s' "${s#"${s%%[![:space:]]*}"}"
}

_timeout() {
  local seconds="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$seconds" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$seconds" "$@"
  elif command -v perl >/dev/null 2>&1; then
    perl -e 'my $seconds = shift @ARGV; alarm $seconds; exec @ARGV or die "exec: $!\n"' "$seconds" "$@"
  else
    "$@"
  fi
}

_b64_encode() { base64 | tr -d '\n'; }

_file_mtime() {
  if _is_macos; then
    stat -f %m "$1"
  else
    stat -c %Y "$1"
  fi
}

_file_recent() {
  local path="$1" max_age="$2" now mtime
  [ -e "$path" ] || return 1
  now="$(date +%s)"
  mtime="$(_file_mtime "$path" 2>/dev/null)" || return 1
  [ "$((now - mtime))" -lt "$max_age" ]
}

_is_mountpoint() {
  local mp="$1"
  if command -v mountpoint >/dev/null 2>&1; then
    _timeout 3 mountpoint -q "$mp" 2>/dev/null
  else
    mount | awk -v mp="$mp" 'index($0, " on " mp " (") > 0 {found=1} END {exit found ? 0 : 1}'
  fi
}

_unmount_fuse() {
  local mp="$1"
  if command -v fusermount3 >/dev/null 2>&1; then
    fusermount3 -uz "$mp"
  elif command -v fusermount >/dev/null 2>&1; then
    fusermount -uz "$mp"
  elif _is_macos; then
    diskutil unmount force "$mp" >/dev/null 2>&1 || umount -f "$mp"
  else
    umount -l "$mp"
  fi
}

_find_brew() {
  command -v brew 2>/dev/null && return 0
  [ -x /opt/homebrew/bin/brew ] && { printf '%s\n' /opt/homebrew/bin/brew; return 0; }
  [ -x /usr/local/bin/brew ] && { printf '%s\n' /usr/local/bin/brew; return 0; }
  return 1
}

_find_port() {
  command -v port 2>/dev/null && return 0
  [ -x /opt/local/bin/port ] && { printf '%s\n' /opt/local/bin/port; return 0; }
  return 1
}

_find_sshfs() {
  command -v sshfs 2>/dev/null && return 0
  [ -x /opt/homebrew/bin/sshfs ] && { printf '%s\n' /opt/homebrew/bin/sshfs; return 0; }
  [ -x /usr/local/bin/sshfs ] && { printf '%s\n' /usr/local/bin/sshfs; return 0; }
  [ -x /opt/local/bin/sshfs ] && { printf '%s\n' /opt/local/bin/sshfs; return 0; }
  return 1
}

_sshfs_bin() {
  if _is_macos; then
    _find_sshfs
  else
    command -v sshfs
  fi
}

_macos_port_pkg() {
  case "$1" in
    sshfs|sshfs-mac) printf 'sshfs' ;;
    *)               printf '%s' "$1" ;;
  esac
}

_macos_brew_pkg() {
  case "$1" in
    sshfs|sshfs-mac) printf 'sshfs-mac' ;;
    *)               printf '%s' "$1" ;;
  esac
}

_pkg_install_note() {
  local pkg="$1"
  if _is_macos; then
    local brew port
    if brew="$(_find_brew 2>/dev/null)"; then
      case "$pkg" in
        sshfs|sshfs-mac) printf '%s install --cask sshfs-mac' "$brew" ;;
        *)               printf '%s install %s' "$brew" "$(_macos_brew_pkg "$pkg")" ;;
      esac
    elif port="$(_find_port 2>/dev/null)"; then
      printf 'sudo %s install %s' "$port" "$(_macos_port_pkg "$pkg")"
    elif [ "$pkg" = sshfs ] || [ "$pkg" = sshfs-mac ]; then
      printf 'install macFUSE + SSHFS manually: https://macfuse.github.io/'
    else
      printf 'install %s manually or with your package manager' "$pkg"
    fi
  else
    printf 'apt install %s' "$pkg"
  fi
}

_dep_install_hints() {
  local missing="$1" pkg formulae="" casks="" ports="" brew port
  if _is_macos; then
    if brew="$(_find_brew 2>/dev/null)"; then
      for pkg in $missing; do
        case "$pkg" in
          sshfs|sshfs-mac) casks="$casks sshfs-mac" ;;
          *)               formulae="$formulae $(_macos_brew_pkg "$pkg")" ;;
        esac
      done
      [ -z "$formulae" ] || printf '%s install%s\n' "$brew" "$formulae"
      [ -z "$casks" ] || printf '%s install --cask%s\n' "$brew" "$casks"
    elif port="$(_find_port 2>/dev/null)"; then
      for pkg in $missing; do ports="$ports $(_macos_port_pkg "$pkg")"; done
      [ -z "$ports" ] || printf 'sudo %s install%s\n' "$port" "$ports"
    else
      for pkg in $missing; do
        case "$pkg" in
          sshfs|sshfs-mac)
            printf 'Install macFUSE: https://macfuse.github.io/\n'
            printf 'Install SSHFS for macFUSE: https://github.com/macfuse/macfuse/wiki/File-Systems-%E2%80%90-SSHFS\n' ;;
          *)
            printf 'Install %s manually or with your package manager.\n' "$pkg" ;;
        esac
      done
    fi
  elif command -v apt-get >/dev/null 2>&1; then
    printf 'sudo apt-get update -qq && sudo apt-get install -y %s\n' "$missing"
  else
    printf 'install equivalent packages: %s\n' "$missing"
  fi
}

_can_auto_install_deps() {
  if _is_macos; then
    _find_brew >/dev/null 2>&1 || _find_port >/dev/null 2>&1
  else
    command -v apt-get >/dev/null 2>&1
  fi
}

_install_missing_deps() {
  local missing="$1" pkg formulae="" casks="" ports="" brew port
  if _is_macos; then
    if brew="$(_find_brew 2>/dev/null)"; then
      for pkg in $missing; do
        case "$pkg" in
          sshfs|sshfs-mac) casks="$casks sshfs-mac" ;;
          *)               formulae="$formulae $(_macos_brew_pkg "$pkg")" ;;
        esac
      done
      [ -z "$formulae" ] || "$brew" install $formulae
      [ -z "$casks" ] || "$brew" install --cask $casks
    elif port="$(_find_port 2>/dev/null)"; then
      for pkg in $missing; do ports="$ports $(_macos_port_pkg "$pkg")"; done
      [ -z "$ports" ] || sudo "$port" install $ports
    else
      return 1
    fi
  else
    command -v apt-get >/dev/null 2>&1 || return 1
    sudo apt-get update -qq && sudo apt-get install -y $missing
  fi
}

# POSIX single-quote escaping for safe embedding in a remote shell string.
_shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

_unit_quote() {
  printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

_xml_escape() {
  printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

# Read one key from an env-style config file (no sourcing -> no code execution).
_get() { sed -n "s/^$2=//p" "$1" | head -n1; }

_safe_id() { printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'; }

_path_base() {
  local b
  b="$(basename "$1")"
  [ "$b" = "/" ] && b="root"
  printf '%s\n' "$b"
}

_socket_for_host() {
  local host="$1" port="${2:-}"
  [ -n "$port" ] || port="default"
  printf '%s/.ssh/cm-rah-%s-%s\n' "$HOME" "$(_safe_id "$host")" "$(_safe_id "$port")"
}

_default_mountpoint() {
  local host="$1" remote_path="$2" base
  base="$(_safe_id "$(_path_base "$remote_path")")"
  printf '%s/%s\n' "$RAH_MOUNT_ROOT" "$base"
}

_default_mount_name() {
  local host="$1" remote_path="$2"
  _safe_id "${host}_$(_path_base "$remote_path")"
}

_default_remote_path() {
  local base
  base="$(_path_base "$PWD")"
  case "$base" in ""|.|/) base="project" ;; esac
  printf '~/%s\n' "$base"
}

_setup_command_preview() {
  local port="$1" target="$2" local_arg="$3" same_path="$4" prelude_set="$5" prelude="$6"
  local cmd="rah setup"
  [ -n "$port" ] && cmd="$cmd --port $(_shq "$port")"
  [ "$same_path" -eq 1 ] && cmd="$cmd --same-path"
  [ "$prelude_set" = 1 ] && cmd="$cmd --prelude $(_shq "$prelude")"
  cmd="$cmd $(_shq "$target")"
  [ -n "$local_arg" ] && cmd="$cmd $(_shq "$local_arg")"
  printf '%s\n' "$cmd"
}

_setup_collect_target() {
  local in_target="$1" in_port="$2" out_file="$3"
  local ssh_target="" remote_raw="" remote_default="" ans="" port="$in_port" target="$in_target"

	  if [ -z "$target" ]; then
	    _interactive || _die "setup needs a remote target in non-interactive shells. Run: rah setup [--port PORT] user@host:~/project [local-path]"
	    _say_header "Remote"
	    ssh_target="$(_prompt '  ssh target (alias or user@host): ')"
	    [ -n "$ssh_target" ] || _die "no ssh target given"
    if [ -z "$port" ]; then
      ans="$(_prompt '  ssh port [ssh config/default]: ')"
      port="$ans"
    fi
    remote_default="$(_default_remote_path)"
    ans="$(_prompt "  remote project path [$remote_default]: ")"
    remote_raw="${ans:-$remote_default}"
    target="$ssh_target:$remote_raw"
	  elif [[ "$target" != *:* ]]; then
	    _interactive || _die "expected user@host:/path or user@host:~/path, got: $target"
	    _say_header "Remote"
	    ssh_target="$target"
    if [ -z "$port" ]; then
      ans="$(_prompt 'ssh port [ssh config/default]: ')"
      port="$ans"
    fi
    remote_default="$(_default_remote_path)"
    ans="$(_prompt "remote project path [$remote_default]: ")"
    remote_raw="${ans:-$remote_default}"
    target="$ssh_target:$remote_raw"
  fi

  case "$port" in ""|*[!0-9]*) [ -z "$port" ] || _die "--port must be numeric: $port" ;; esac
  case "$target" in *:*) ;; *) _die "expected user@host:/path or user@host:~/path, got: $target" ;; esac
  {
    printf 'target=%s\n' "$target"
    printf 'port=%s\n' "$port"
  } > "$out_file"
}

_trim_trailing_slashes() {
  local p="$1"
  while [ "$p" != "/" ] && [ "${p%/}" != "$p" ]; do p="${p%/}"; done
  printf '%s\n' "$p"
}

_expand_local_path() {
  local p="${1:-.}"
  case "$p" in
    "~") p="$HOME" ;;
    "~/"*) p="$HOME/${p:2}" ;;
    "~"*) _die "local ~user paths are not supported: $p" ;;
    /*) ;;
    *) p="$PWD/$p" ;;
  esac
  _trim_trailing_slashes "$p"
}

_resolve_remote_path() {
  local host="$1" p="$2" port="${3:-}" home="" ssh_args=()
  [ -n "$port" ] && ssh_args=(-p "$port")
  case "$p" in
    "~")
      ssh "${ssh_args[@]}" -o BatchMode=yes "$host" 'printf %s "$HOME"' ;;
    "~/"*)
      home="$(ssh "${ssh_args[@]}" -o BatchMode=yes "$host" 'printf %s "$HOME"')" || return 1
      printf '%s/%s\n' "$home" "${p:2}" ;;
    /*)
      printf '%s\n' "$p" ;;
    *)
      return 2 ;;
  esac
}

_prepare_mountpoint() {
  local mp="$1" allow_sudo="${2:-0}" first=""
  if ! mkdir -p "$mp" 2>/dev/null; then
    if [ "$allow_sudo" = 1 ] && _confirm "local mount path $mp needs root to create once — do it with sudo?"; then
      sudo mkdir -p "$mp" && sudo chown "$USER": "$mp" || return 1
    else
      echo "rah: cannot create local mountpoint $mp. Run once:" >&2
      echo "  sudo mkdir -p $(_shq "$mp") && sudo chown $USER: $(_shq "$mp")" >&2
      return 1
    fi
  fi
  mp="$(cd -P "$mp" && pwd -P)" || return 1
  if ! _is_mountpoint "$mp"; then
    first="$(find "$mp" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null | head -n 1 || true)"
    if [ -n "$first" ]; then
      echo "rah: local mountpoint is not empty: $mp" >&2
      echo "  choose an empty directory, or pass another local path." >&2
      return 1
    fi
  fi
  printf '%s\n' "$mp"
}

# Prompt the user via the terminal, even when stdin is a pipe (curl | bash).
# A controlling terminal exists only if /dev/tty can actually be opened.
_interactive() { ( : >/dev/tty ) 2>/dev/null; }

_prompt() {
  local msg="$1" ans=""
  if _interactive; then printf '%s' "$msg" >/dev/tty; IFS= read -r ans </dev/tty || true; fi
  printf '%s' "$ans"
}

# Yes/no prompt (Enter = yes). Honors RAH_YES=1; declines if non-interactive.
_confirm() {
  [ "${RAH_YES:-0}" = 1 ] && return 0
  _interactive || return 1
  local ans=""; printf '%s [Y/n] ' "$1" >/dev/tty; IFS= read -r ans </dev/tty || true
  case "$ans" in [nN]*) return 1 ;; *) return 0 ;; esac
}

_list_configs() {
  [ -d "$RAH_CONFIG_DIR" ] || return 0
  local f
  for f in "$RAH_CONFIG_DIR"/*.env; do
    [ -e "$f" ] && printf '%s\n' "$f"
  done
}

# Print the config file whose mountpoint is a prefix of $1 (the cwd). Non-zero if none.
_config_for_cwd() {
  local cwd="$1" f mp
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    mp="$(_get "$f" mountpoint)"
    [ -n "$mp" ] || continue
    case "$cwd/" in
      "$mp"/*) printf '%s\n' "$f"; return 0 ;;
    esac
  done < <(_list_configs)
  return 1
}

_config_for_mountpoint_exact() {
  local mp="$1" f cfg_mp
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    cfg_mp="$(_get "$f" mountpoint)"
    [ "$cfg_mp" = "$mp" ] && { printf '%s\n' "$f"; return 0; }
  done < <(_list_configs)
  return 1
}

_remote_cwd() {
  local cfg="$1" cwd="$2" mp remote suffix
  mp="$(_get "$cfg" mountpoint)"
  remote="$(_get "$cfg" remote_path)"
  case "$cwd/" in
    "$mp"/*)
      suffix="${cwd#"$mp"}"
      printf '%s%s\n' "$remote" "$suffix"
      return 0 ;;
  esac
  printf '%s\n' "$cwd"
}

_translate_command_paths() {
  local cfg="$1" cmd="$2" mp remote
  mp="$(_get "$cfg" mountpoint)"
  remote="$(_get "$cfg" remote_path)"
  if [ -n "$mp" ] && [ "$mp" != "$remote" ]; then
    cmd="${cmd//$mp/$remote}"
  fi
  printf '%s' "$cmd"
}

_is_env_assignment_word() {
  case "$1" in
    [A-Za-z_]*=*) return 0 ;;
    *)            return 1 ;;
  esac
}

# True when a tool command is invoking rah itself. Control-plane rah commands must
# stay local even when the agent cwd is inside a managed mount.
_is_rah_control_command() {
  local s word
  s="$(_trim_leading_ws "$1")"
  while [ -n "$s" ]; do
    word="${s%%[[:space:]]*}"
    if [ "$word" = "$s" ]; then
      s=""
    else
      s="$(_trim_leading_ws "${s#"$word"}")"
    fi
    case "$word" in
      env|command) continue ;;
      rah|*/rah|./rah) return 0 ;;
    esac
    if _is_env_assignment_word "$word"; then
      continue
    fi
    return 1
  done
  return 1
}

# Fast, timeout-guarded liveness probe. A dead fuse mount hangs on access, so this
# must never run unguarded. Returns 0 if the path is reachable.
_mount_alive() { _timeout 2 stat "$1" >/dev/null 2>&1; }

# Classify a mountpoint: mounted | dead | unmounted. `mountpoint -q` alone lies
# (a dead fuse mount still reports as mounted), so combine it with a liveness probe.
_mount_state() {
  local mp="$1"
  if _is_mountpoint "$mp"; then
    _mount_alive "$mp" && echo mounted || echo dead
  elif _timeout 3 stat "$mp" >/dev/null 2>&1; then
    echo unmounted
  else
    echo dead
  fi
}

# Wait until the kernel reports a live FUSE mount.  sshfs normally backgrounds
# itself after a successful mount, so its immediate exit status alone is not a
# sufficient success signal.
_wait_for_mount() {
  local mp="$1" attempts="${2:-5}" i
  for ((i = 0; i < attempts; i++)); do
    [ "$(_mount_state "$mp")" = mounted ] && return 0
    sleep 1
  done
  return 1
}

# Passwordless ssh reachability probe (BatchMode: never blocks on a password prompt).
_ssh_ok() {
  local host="$1" port="${2:-}" ssh_args=()
  [ -n "$port" ] && ssh_args=(-p "$port")
  ssh "${ssh_args[@]}" -o BatchMode=yes -o ConnectTimeout=5 "$host" true 2>/dev/null
}

_ssh_failure_details() {
  local host="$1" port="${2:-}" out="" ssh_args=()
  [ -n "$port" ] && ssh_args=(-p "$port")
  out="$(ssh "${ssh_args[@]}" -o BatchMode=yes -o ConnectTimeout=5 "$host" true 2>&1 >/dev/null || true)"
  printf '%s\n' "$out" | sed '/^$/d' | head -n 3
}

_explain_ssh_failure() {
  local host="$1" port="${2:-}" details="" target="$1"
  [ -n "$port" ] && target="$target -p $port"
  details="$(_ssh_failure_details "$host" "$port")"
  printf '%b\n' "${RAH_RED}rah: error:${RAH_RESET} ssh preflight failed for '$target'." >&2
  if [ -n "$details" ]; then
    printf '%s\n' "$details" | sed 's/^/  ssh: /' >&2
  fi
  if [ -n "$port" ]; then
    printf '%b\n' "  ${RAH_CYAN}ssh -p $port -o BatchMode=yes -o ConnectTimeout=5 $host true${RAH_RESET}" >&2
  else
    printf '%b\n' "  ${RAH_CYAN}ssh -o BatchMode=yes -o ConnectTimeout=5 $host true${RAH_RESET}" >&2
  fi
  echo "  if you normally use an ssh alias, use that alias in the rah target." >&2
  _suggest_nat_traversal >&2
}

# Guidance for when the remote cannot accept inbound ssh because it sits behind
# NAT / has no public IP. rah needs a reachable ssh destination; NAT traversal is
# solved one layer below rah (an overlay network or a reverse tunnel) and then
# consumed through an ~/.ssh/config alias. Prints to stdout; callers redirect to
# stderr where the surrounding output goes there.
_suggest_nat_traversal() {
  printf '%b\n' "  ${RAH_DIM}remote behind NAT / no public IP? it cannot accept inbound ssh —${RAH_RESET}"
  printf '%b\n' "  ${RAH_DIM}give it reachability one layer below rah, then point rah at the alias:${RAH_RESET}"
  if command -v tailscale >/dev/null 2>&1; then
    printf '%b\n' "    ${RAH_CYAN}tailscale status${RAH_RESET}   # Tailscale (recommended): find the remote's MagicDNS name"
  else
    printf '%b\n' "    ${RAH_CYAN}# Tailscale (recommended): install on both ends -> https://tailscale.com/download${RAH_RESET}"
  fi
  printf '%b\n' "    ${RAH_CYAN}# or reverse SSH tunnel: remote runs 'autossh -M 0 -R 2222:localhost:22 relay'${RAH_RESET}"
  printf '%b\n' "  ${RAH_DIM}put HostName/Port/ProxyJump in ~/.ssh/config under 'Host myremote', then:${RAH_RESET}"
  printf '%b\n' "    ${RAH_CYAN}rah setup myremote:/path${RAH_RESET}"
}

_authorize_ssh_key() {
  local host="$1" port="${2:-}" pub="" ssh_args=()
  [ -n "$port" ] && ssh_args=(-p "$port")
  if command -v ssh-copy-id >/dev/null 2>&1; then
    if [ -n "$port" ]; then
      ssh-copy-id -p "$port" "$host"
    else
      ssh-copy-id "$host"
    fi
    return $?
  fi

  pub="$(ls "$HOME"/.ssh/id_*.pub 2>/dev/null | head -n 1 || true)"
  [ -n "$pub" ] || return 1
  _say_warn "ssh-copy-id not found; appending $pub with ssh fallback"
  cat "$pub" | ssh "${ssh_args[@]}" "$host" 'umask 077; mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys && chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys'
}

# Print the active hook log path. Logging is disabled unless RAH_HOOK_LOG is set
# or `rah hook-log on` has written a flag file.
_hook_log_path() {
  local v
  if [ "${RAH_HOOK_LOG+x}" ]; then
    v="$RAH_HOOK_LOG"
    case "$v" in ""|0|false|False|FALSE|off|OFF|no|NO) return 1 ;; esac
  else
    [ -f "$RAH_HOOK_LOG_FLAG" ] || return 1
    v="$(sed -n '1p' "$RAH_HOOK_LOG_FLAG" 2>/dev/null)"
    [ -n "$v" ] || v=1
  fi

  case "$v" in
    1|true|True|TRUE|on|ON|yes|YES) printf '%s\n' "$RAH_HOOK_LOG_DEFAULT" ;;
    *) printf '%s\n' "$v" ;;
  esac
}

_hook_log_event() {
  local tool="$1" reported_cwd="$2" tool_cwd="$3" effective_cwd="$4" matched="$5" cfg="$6"
  local action="$7" reason="$8" configured_decision="$9" emitted_decision="${10}" updated="${11}" command="${12}"
  local path dir command_log truncated=0
  path="$(_hook_log_path)" || return 0
  dir="$(dirname "$path")"
  mkdir -p "$dir" 2>/dev/null || return 0

  command_log="$command"
  if [ "${#command_log}" -gt 1000 ]; then
    command_log="${command_log:0:1000}"
    truncated=1
  fi

  jq -nc \
    --arg ts "$(date -Is 2>/dev/null || date)" \
    --arg pid "$$" \
    --arg tool "$tool" \
    --arg pwd "$PWD" \
    --arg reported_cwd "$reported_cwd" \
    --arg tool_input_cwd "$tool_cwd" \
    --arg effective_cwd "$effective_cwd" \
    --arg cfg "$cfg" \
    --arg action "$action" \
    --arg reason "$reason" \
    --arg configured_decision "$configured_decision" \
    --arg emitted_decision "$emitted_decision" \
    --arg command "$command_log" \
    --argjson matched_mount "$matched" \
    --argjson updated_input "$updated" \
    --argjson command_truncated "$truncated" \
    '{ts:$ts,pid:($pid|tonumber),event:"PreToolUse",triggered:true,tool:$tool,pwd:$pwd,
      reported_cwd:$reported_cwd,tool_input_cwd:$tool_input_cwd,effective_cwd:$effective_cwd,
      matched_mount:$matched_mount,config:(if $cfg == "" then null else $cfg end),
      action:$action,reason:$reason,configured_decision:$configured_decision,
      emitted_decision:$emitted_decision,updated_input:$updated_input,
      command:$command,command_truncated:$command_truncated}' >> "$path" 2>/dev/null || true
}

# Space-separated packages for any missing required deps (deduped; empty if all present).
_missing_pkgs() {
  local d bin out=""
  for d in "${RAH_DEPS[@]}"; do
    bin="${d%%:*}"
    if _is_macos && [ "$bin" = sshfs ]; then
      _find_sshfs >/dev/null 2>&1 || out="$out ${d#*:}"
    else
      command -v "$bin" >/dev/null 2>&1 || out="$out ${d#*:}"
    fi
  done
  if ! _is_macos; then
    command -v fusermount >/dev/null 2>&1 || command -v fusermount3 >/dev/null 2>&1 || out="$out fuse3"
  fi
  printf '%s\n' $out | sort -u | xargs
}

# The skill document, emitted into each agent's skills dir by `rah init`.
_skill_doc() {
  cat <<'RAHSKILL'
---
name: rah
description: Remote as Host — manage the sshfs mount and remote execution for this machine. Use when the user asks to mount/unmount a remote project, set up "remote as host", check mount/ssh health (rah status), or recover a broken mount. Note that command execution in a rah-managed directory is ALREADY auto-routed to the remote by a hook — you do not need to add ssh yourself.
---

# rah — Remote as Host

`rah` lets this host act as a remote dev box: files are edited through an sshfs
mount, while command execution is transparently routed to the remote over ssh
by a `PreToolUse` hook. **You do not need to prefix commands with `ssh` or do anything
special — when the working directory is a rah-managed mount, your normal Bash commands
already run on the remote (with its GPU, datasets, and environment).**

## When to use this skill

Only for **control-plane** actions: setting up, mounting, checking health, or recovering.
Execution routing is automatic; never wrap commands in ssh manually.

## Commands

- `rah setup` — interactive onboarding: asks for ssh target, port, remote project path, and
  local mount directory; then checks dependencies, wires the installed agents, and mounts.
- `rah setup [--port PORT] user@host:/path [local-path]` — scriptable form of the same flow.
  `~/path` is accepted for the remote path.
- `rah status` / `rah list` — global status for all managed mounts by default; use
  `rah status --current` to show only the mount for the current directory.
- `rah mount [--name N] [--port PORT] [--prelude 'CMD'] user@host:/path [local-path]` — mount a remote
  code tree at a local directory. If no local path is given, rah uses
  `~/mnt_rah/<project>`. Use `.` for the current directory, or `--same-path` when
  you intentionally want identical-path mode. `--prelude` is a shell snippet run before
  each remote command (e.g. `source .venv/bin/activate`) to fix the remote environment.
- `rah remount [name|path]` — recover a dead/stale/unmounted mount (re-establishes ssh + sshfs).
  No target = all. Healthy mounts are left alone; use `--force` to rebuild them.
- `rah autostart on|off|status` — install or inspect a user-level boot/login remount job
  (systemd --user on Linux, launchd on macOS).
- `rah unmount <name|path>` — unmount and drop the ssh master connection, keeping the config.
- `rah remove [--keep-local] [name|path]` — unmount, remove rah config, and remove the empty mountpoint directory.
- `rah init <claude|codex>` — install the routing hook and this skill for an agent.

## Recovery

If file tools fail with `Transport endpoint is not connected` or hang, the mount has died. Run
`rah remount` (it executes locally) and retry. Command execution over ssh keeps working even
while the mount is down, since it is a separate channel.

Use `rah autostart on` after setup if mounts should be restored automatically after reboot/login.

## Remote behind NAT

If ssh to the remote fails because it is behind NAT / has no public IP (it cannot accept
inbound ssh), rah cannot reach it directly. Tell the user to give it reachability one layer
below rah, then use an `~/.ssh/config` alias:
- **Tailscale (recommended):** install on both machines, `tailscale up`, then use the
  remote's MagicDNS name. Works even when both ends are behind NAT (no public IP/VPS needed).
- **Reverse SSH tunnel:** the remote runs `autossh -M 0 -R 2222:localhost:22 <relay>` to a
  public relay; reach it via `HostName localhost`/`Port 2222` or `ProxyJump <relay>`.

Put HostName/Port/ProxyJump in `~/.ssh/config` under `Host <alias>`, then run
`rah setup <alias>:/path` — both exec and the sshfs mount inherit it; rah needs no extra flags.

## Notes

- Only the **code tree** is mounted; datasets/outputs stay on the remote and are reached
  natively when commands execute there. Don't try to read large datasets through the mount.
- If a command must inspect remote outputs/logs, just run `cat`/`ls`/`tail` normally — it
  executes on the remote.
- `cd` within the mount works locally and is preserved across commands; everything else runs remote.
RAHSKILL
}

# ---------- mount internals ----------

# Ensure a persistent ssh master connection at $socket. Returns non-zero on failure.
_ensure_master() {
  local host="$1" socket="$2" port="${3:-}" ssh_args=() lock held=0 i rc=0 lock_mtime
  [ -n "$port" ] && ssh_args=(-p "$port")
  ssh "${ssh_args[@]}" -S "$socket" -O check "$host" 2>/dev/null && return 0

  # Creating the master is check-then-act, and ssh cannot adopt a socket path that
  # already exists: concurrent creators all miss the check, all run the create, and
  # every loser is left as an unmultiplexed -fN process that ControlPersist never
  # reaps. That is not hypothetical -- `rah autostart on` starts every unit at once
  # and two mounts can share one host. mkdir is the portable atomic mutex; a lock
  # nobody has touched for a minute belongs to a caller that died mid-flight.
  lock="$socket.lock"
  for ((i = 0; i < 60; i++)); do
    if mkdir "$lock" 2>/dev/null; then held=1; break; fi
    # Reap only a lock whose age we can positively read and prove old: treating an
    # unreadable mtime as "stale" would yank the lock out from under a live holder,
    # which puts the race straight back.
    lock_mtime="$(_file_mtime "$lock" 2>/dev/null || true)"
    if [ -n "$lock_mtime" ] && [ "$(( $(date +%s) - lock_mtime ))" -ge 60 ]; then
      rmdir "$lock" 2>/dev/null || true
    fi
    sleep 0.5
  done

  # Whoever held the lock may have created the master while we waited.
  if ssh "${ssh_args[@]}" -S "$socket" -O check "$host" 2>/dev/null; then
    [ "$held" = 1 ] && rmdir "$lock" 2>/dev/null || true
    return 0
  fi

  # The socket *file* can also outlive a master that died without cleaning up. ssh
  # then prints "ControlSocket ... already exists, disabling multiplexing" and leaks
  # in exactly the same way, so drop the stale path before creating the master.
  if [ -e "$socket" ]; then
    ssh "${ssh_args[@]}" -S "$socket" -O exit "$host" 2>/dev/null || true
    rm -f "$socket"
  fi
  ssh "${ssh_args[@]}" -M -S "$socket" -o ControlPersist=600 -fN "$host" || rc=$?
  # With ControlPersist, -f returns as soon as the master is forked, before it has
  # bound the socket. Releasing the lock here would let the next caller's check miss
  # again and create a second master, so hold it until the socket actually answers.
  if [ "$rc" -eq 0 ]; then
    for ((i = 0; i < 40; i++)); do
      ssh "${ssh_args[@]}" -S "$socket" -O check "$host" 2>/dev/null && break
      sleep 0.25
    done
  fi
  [ "$held" = 1 ] && rmdir "$lock" 2>/dev/null || true
  return "$rc"
}

_remote_uname() {
  local host="$1" socket="$2" port="${3:-}" ssh_args=()
  [ -n "$port" ] && ssh_args=(-p "$port")
  ssh "${ssh_args[@]}" -S "$socket" "$host" 'uname -s 2>/dev/null || true' 2>/dev/null | head -n1
}

# Mount remote_path at mp. Re-establishes master, clears a stale mount,
# and skips work if already healthy. When foreground is set, replace the
# current process with sshfs so a service manager can own its lifecycle.
_do_mount() {
  local host="$1" remote_path="$2" mp="$3" socket="$4" port="${5:-}" foreground="${6:-0}" sshfs_args=() foreground_args=() opts remote_os sshfs_bin
  [ -n "$port" ] && sshfs_args=(-p "$port")
  [ "$foreground" = 1 ] && foreground_args=(-f)
  sshfs_bin="$(_sshfs_bin)" || return 1
  _ensure_master "$host" "$socket" "$port" || return 1
  if _is_mountpoint "$mp"; then
    _mount_alive "$mp" && return 0               # already mounted & healthy
    _unmount_fuse "$mp" 2>/dev/null || true      # stale -> clear before remount
  fi
  opts="reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,follow_symlinks,ControlPath=$socket"
  _is_macos && opts="$opts,defer_permissions"
  remote_os="$(_remote_uname "$host" "$socket" "$port")"
  case "$remote_os" in
    Darwin) opts="$opts,sftp_server=/usr/libexec/sftp-server" ;;
  esac
  if [ "$foreground" = 1 ]; then
    exec "$sshfs_bin" "${foreground_args[@]}" "${sshfs_args[@]}" "$host:$remote_path" "$mp" \
      -o "$opts"
  else
    "$sshfs_bin" "${sshfs_args[@]}" "$host:$remote_path" "$mp" \
      -o "$opts"
  fi
}

# ---------- mount ----------

cmd_mount() {
  local name="" prelude="" target="" local_arg="" port="" same_path=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)    name="$2"; shift 2 ;;
      --prelude) prelude="$2"; shift 2 ;;
      --local)   local_arg="$2"; shift 2 ;;
      --port)    port="$2"; shift 2 ;;
      --same-path) same_path=1; shift ;;
      --*)       _die "unknown option: $1" ;;
      *)
        if [ -z "$target" ]; then
          target="$1"
        elif [ -z "$local_arg" ]; then
          local_arg="$1"
        else
          _die "too many arguments: $1"
        fi
        shift ;;
    esac
  done
  [ -n "$target" ] || _die "usage: rah mount [--name N] [--prelude CMD] user@host:/path [local-path]"
  [ "$same_path" -eq 0 ] || [ -z "$local_arg" ] || _die "--same-path cannot be combined with a local path"
  case "$port" in ""|*[!0-9]*) [ -z "$port" ] || _die "--port must be numeric: $port" ;; esac

  case "$target" in *:*) ;; *) _die "expected user@host:/path or user@host:~/path, got: $target" ;; esac
  # host may be an ~/.ssh/config alias; custom Port/ProxyJump/ProxyCommand live in
  # ssh_config and are inherited by both ssh and sshfs (see "Remote behind NAT" docs).
  local host="${target%%:*}" remote_raw="${target#*:}" remote_path
  if ! _ssh_ok "$host" "$port"; then
    _explain_ssh_failure "$host" "$port"
    _die "fix ssh for '$host', then retry rah mount"
  fi
  if ! remote_path="$(_resolve_remote_path "$host" "$remote_raw" "$port")"; then
    _die "remote path must be absolute or ~/relative: $remote_raw"
  fi
  remote_path="$(_trim_trailing_slashes "$remote_path")"

  [ -n "$name" ] || name="$(_default_mount_name "$host" "$remote_path")"
  mkdir -p "$RAH_CONFIG_DIR"

  local cfg="$RAH_CONFIG_DIR/$name.env"
  local mountpoint mode="mapped" cfg_host cfg_remote cfg_port cfg_mode
  if [ "$same_path" -eq 1 ]; then
    local_arg="$remote_path"
    mode="same-path"
  else
    if [ -z "$local_arg" ]; then
      if [ -f "$cfg" ]; then
        cfg_host="$(_get "$cfg" host)"
        cfg_remote="$(_get "$cfg" remote_path)"
        cfg_port="$(_get "$cfg" ssh_port)"
        if [ "$cfg_host" = "$host" ] && [ "$cfg_remote" = "$remote_path" ] && [ "$cfg_port" = "$port" ]; then
          local_arg="$(_get "$cfg" mountpoint)"
          cfg_mode="$(_get "$cfg" mode)"
          [ -n "$cfg_mode" ] && mode="$cfg_mode"
        fi
      fi
      [ -n "$local_arg" ] || local_arg="$(_default_mountpoint "$host" "$remote_path")"
    fi
  fi
  mountpoint="$(_expand_local_path "$local_arg")"
  local socket="$(_socket_for_host "$host" "$port")"

  local owner_cfg owner_host owner_remote owner_port
  if _is_mountpoint "$mountpoint"; then
    if owner_cfg="$(_config_for_mountpoint_exact "$mountpoint")"; then
      owner_host="$(_get "$owner_cfg" host)"
      owner_remote="$(_get "$owner_cfg" remote_path)"
      owner_port="$(_get "$owner_cfg" ssh_port)"
      if [ "$owner_host" != "$host" ] || [ "$owner_remote" != "$remote_path" ] || [ "$owner_port" != "$port" ]; then
        _die "local mountpoint already belongs to another rah mount: $mountpoint
  existing: $owner_host:$owner_remote${owner_port:+ port $owner_port}
  choose a different local path."
      fi
    else
      _die "local mountpoint is already mounted but not managed by rah: $mountpoint
  choose a different local path."
    fi
  fi

  mountpoint="$(_prepare_mountpoint "$mountpoint" 0)" || exit 1
  [ "$mountpoint" = "$remote_path" ] && mode="same-path"

  _do_mount "$host" "$remote_path" "$mountpoint" "$socket" "$port" || _die "mount failed (host $host)"

  {
    printf 'host=%s\n'           "$host"
    printf 'remote_path=%s\n'    "$remote_path"
    printf 'mountpoint=%s\n'     "$mountpoint"
    printf 'mode=%s\n'           "$mode"
    printf 'control_socket=%s\n' "$socket"
    printf 'ssh_port=%s\n'       "$port"
    printf 'prelude=%s\n'        "$prelude"
  } > "$cfg"
  if _systemd_autostart_configured; then
    _systemd_enable_mount_service "$name" || _say_warn "could not enable automatic recovery for $name"
  fi
  _say_ok "mounted $name"
  _say_note "remote: $host:$remote_path${port:+ port $port}"
  _say_note "local:  $mountpoint [$mode]"
  _say_note "config: $cfg"
}

cmd_remount() {
  local names=() cfg name host remote_path mp socket port arg force=0 best_effort=0 state failed=0
  if [ $# -gt 0 ]; then
    while [ $# -gt 0 ]; do
      case "$1" in
        -f|--force) force=1; shift ;;
        --best-effort) best_effort=1; shift ;;
        --*) _die "usage: rah remount [--force] [name|path ...]" ;;
        *)
          arg="$1"; shift
          if cfg="$(_cfg_from_arg_or_cwd "$arg" 2>/dev/null)"; then
            names+=("$(basename "$cfg" .env)")
          else
            names+=("$arg")
          fi ;;
      esac
    done
  fi
  if [ "${#names[@]}" -eq 0 ]; then
    while IFS= read -r cfg; do [ -n "$cfg" ] && names+=("$(basename "$cfg" .env)"); done < <(_list_configs)
  fi
  [ "${#names[@]}" -gt 0 ] || _die "no managed mounts to remount"
  for name in "${names[@]}"; do
    cfg="$RAH_CONFIG_DIR/$name.env"
    [ -f "$cfg" ] || { echo "rah: no such mount: $name" >&2; failed=1; continue; }
    host="$(_get "$cfg" host)"; remote_path="$(_get "$cfg" remote_path)"
    mp="$(_get "$cfg" mountpoint)"; socket="$(_get "$cfg" control_socket)"; port="$(_get "$cfg" ssh_port)"
    state="$(_mount_state "$mp")"
    if [ "$force" -eq 0 ] && [ "$state" = mounted ]; then
      _say_ok "already mounted $name"
      _say_note "local: $mp"
      continue
    fi
    if _systemd_mount_service_enabled "$name"; then
      if _systemd_restart_mount_service "$name" && _wait_for_mount "$mp"; then
        _say_ok "remounted $name"
        _say_note "local: $mp"
      else
        echo "rah: remount failed for $name" >&2
        failed=1
      fi
      continue
    fi
    if [ "$state" = unmounted ]; then
      local original_mp="$mp"
      if ! mp="$(_prepare_mountpoint "$mp" 0)"; then
        echo "rah: mountpoint not ready for $name: $original_mp" >&2
        failed=1
        continue
      fi
    fi
    if [ "$force" -eq 1 ] || [ "$state" = dead ]; then
      _unmount_fuse "$mp" 2>/dev/null || true
    fi
    if _do_mount "$host" "$remote_path" "$mp" "$socket" "$port" && _wait_for_mount "$mp"; then
      _say_ok "remounted $name"
      _say_note "local: $mp"
    else
      echo "rah: remount failed for $name" >&2
      failed=1
    fi
  done
  [ "$best_effort" -eq 1 ] && return 0
  return "$failed"
}

cmd_unmount() {
  local target="${1:-}" cfg name
  [ -n "$target" ] || _die "usage: rah unmount <name|path>"
  if ! cfg="$(_cfg_from_arg_or_cwd "$target")"; then
    _die "no such mount: $target"
  fi
  name="$(basename "$cfg" .env)"
  local mp host socket port ssh_args=()
  mp="$(_get "$cfg" mountpoint)"; host="$(_get "$cfg" host)"; socket="$(_get "$cfg" control_socket)"; port="$(_get "$cfg" ssh_port)"
  [ -n "$port" ] && ssh_args=(-p "$port")
  _systemd_stop_mount_service "$name" || true
  if _is_mountpoint "$mp"; then
    _unmount_fuse "$mp" || _die "unmount failed for $mp"
  fi
  ssh "${ssh_args[@]}" -S "$socket" -O exit "$host" 2>/dev/null || true
  _say_ok "unmounted $name"
}

cmd_remove() {
  local keep_local=0 target="" cfg name mp host socket port ssh_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep-local) keep_local=1; shift ;;
      --*) _die "usage: rah remove [--keep-local] <name|path>" ;;
      *)
        [ -z "$target" ] || _die "usage: rah remove [--keep-local] <name|path>"
        target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || target="$PWD"
  if ! cfg="$(_cfg_from_arg_or_cwd "$target")"; then
    _die "no such mount: $target"
  fi

  name="$(basename "$cfg" .env)"
  mp="$(_get "$cfg" mountpoint)"; host="$(_get "$cfg" host)"; socket="$(_get "$cfg" control_socket)"; port="$(_get "$cfg" ssh_port)"
  [ -n "$port" ] && ssh_args=(-p "$port")
  _systemd_disable_mount_service "$name" || true
  _systemd_stop_mount_service "$name" || true
  if _is_mountpoint "$mp"; then
    _unmount_fuse "$mp" || _die "unmount failed for $mp"
    _say_ok "unmounted $name"
  fi
  ssh "${ssh_args[@]}" -S "$socket" -O exit "$host" 2>/dev/null || true
  rm -f "$cfg"
  _say_ok "removed config $name"

  if [ "$keep_local" -eq 0 ] && [ -d "$mp" ]; then
    if rmdir "$mp" 2>/dev/null; then
      _say_ok "removed empty mountpoint $mp"
    else
      _say_warn "kept local directory (not empty): $mp"
    fi
  fi
}

# ---------- run (routing core) ----------

cmd_run() {
  local cwd="" b64cmd=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --cwd) cwd="$2"; shift 2 ;;
      --b64) b64cmd="$2"; shift 2 ;;
      --)    shift; break ;;
      *)     break ;;
    esac
  done
  local cmd
  if [ -n "$b64cmd" ]; then
    cmd="$(printf '%s' "$b64cmd" | base64 -d)"
  else
    cmd="$*"
  fi
  [ -n "$cmd" ] || _die "run: empty command"
  [ -n "$cwd" ] || cwd="$PWD"
  cwd="$(_expand_local_path "$cwd")"

  local cfg
  if ! cfg="$(_config_for_cwd "$cwd")"; then
    # Not under any managed mount -> run locally (safety fallthrough).
    bash -c "$cmd"; exit $?
  fi
  local host socket prelude remote_cwd port ssh_args=()
  host="$(_get "$cfg" host)"; socket="$(_get "$cfg" control_socket)"; prelude="$(_get "$cfg" prelude)"; port="$(_get "$cfg" ssh_port)"
  [ -n "$port" ] && ssh_args=(-p "$port")
  remote_cwd="$(_remote_cwd "$cfg" "$cwd")"
  cmd="$(_translate_command_paths "$cfg" "$cmd")"

  _ensure_master "$host" "$socket" "$port" 2>/dev/null || true   # self-heal a dead master

  local b64 pre=""
  b64="$(printf '%s' "$cmd" | _b64_encode)"
  [ -n "$prelude" ] && pre="{ $prelude; } && "

  local remote="cd $(_shq "$remote_cwd") && ${pre}printf %s $(_shq "$b64") | base64 -d | bash"
  set +e
  ssh "${ssh_args[@]}" -S "$socket" "$host" "$remote"
  local rc=$?
  set -e
  exit $rc
}

# ---------- hook (PreToolUse rewrite; shared by Claude & Codex) ----------

cmd_hook() {
  set +e
  local decision="defer" passthrough_output="defer"
  while [ $# -gt 0 ]; do
    case "$1" in
      --decision) decision="$2"; shift 2 ;;
      --passthrough) passthrough_output="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  case "$decision" in defer|allow|ask) ;; *) decision="defer" ;; esac
  # --passthrough is still parsed so hooks already registered with
  # "--passthrough empty" keep working; passthrough now always emits nothing,
  # so the value itself is no longer consulted.
  case "$passthrough_output" in defer|empty) ;; *) passthrough_output="defer" ;; esac

  local input cmd cwd reported_cwd tool_cwd tool
  input="$(cat)"
  tool="$(printf '%s' "$input" | jq -r '.tool_name // .tool // .toolName // empty' 2>/dev/null)"
  cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty' 2>/dev/null)"
  reported_cwd="$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)"
  tool_cwd="$(printf '%s' "$input" | jq -r '.tool_input.cwd // empty' 2>/dev/null)"
  cwd="$reported_cwd"
  [ -n "$cwd" ] || cwd="$tool_cwd"
  [ -n "$cwd" ] || cwd="$PWD"

  local passthrough=0 cfg="" matched=0 reason=""
  if cfg="$(_config_for_cwd "$cwd" 2>/dev/null)"; then
    matched=1
  elif [ -n "$tool_cwd" ] && cfg="$(_config_for_cwd "$tool_cwd" 2>/dev/null)"; then
    cwd="$tool_cwd"
    matched=1
  else
    passthrough=1
    reason="no-managed-mount"
  fi
  if _is_rah_control_command "$cmd"; then
    passthrough=1
    reason="rah-command"
  fi

  # Opportunistic, throttled, non-blocking mount self-heal (file plane only).
  # Runs at most once per 10s; if the mount is dead or unmounted, fire a detached
  # remount and continue — the command still routes over ssh, independent of files.
  if [ -n "$cfg" ]; then
    local _name _stamp _mp
    _name="$(basename "$cfg" .env)"; _stamp="$RAH_CONFIG_DIR/.heal.$_name"
    if ! _file_recent "$_stamp" 10; then
      : > "$_stamp" 2>/dev/null || true
      _mp="$(_get "$cfg" mountpoint)"
      if [ "$(_mount_state "$_mp")" != mounted ]; then
        if command -v setsid >/dev/null 2>&1; then
          setsid "$(_self_path)" remount "$_name" </dev/null >/dev/null 2>&1 &
        else
          nohup "$(_self_path)" remount "$_name" </dev/null >/dev/null 2>&1 &
        fi
      fi
    fi
  fi

  # Pure navigation (standalone cd/pushd/popd, no chaining) -> keep local to
  # preserve the agent's persistent shell cwd.
  local trimmed="${cmd#"${cmd%%[![:space:]]*}"}"
  case "$trimmed" in
    cd|cd\ *|pushd|pushd\ *|popd|popd\ *)
      case "$cmd" in
        *'&&'*|*';'*|*'|'*|*$'\n'*) : ;;
        *) passthrough=1; reason="navigation" ;;
      esac ;;
  esac

  if [ "$passthrough" -eq 1 ] || [ -z "$cmd" ]; then
    [ -n "$cmd" ] || reason="empty-command"
    _hook_log_event "$tool" "$reported_cwd" "$tool_cwd" "$cwd" "$matched" "$cfg" \
      "passthrough" "$reason" "$decision" "" 0 "$cmd"
    # Emit nothing. "defer" is a valid PreToolUse permissionDecision, but its
    # semantics are print-mode only: an interactive agent warns and ignores it,
    # while a non-interactive/print session takes a branch that drops the tool
    # result outright, so every passthrough command fails there. Both agents
    # want the same thing here anyway -- "no opinion, run normally" -- which the
    # hook protocol expresses as exit 0 with no output.
    return 0
  fi

  # Readable rewrite for commands the agent's local shell passes through verbatim;
  # fall back to base64 transport when shell metacharacters would be re-parsed.
  local newcmd
  case "$cmd" in
    *[!A-Za-z0-9\ _.,=/+:@%-]*)
      newcmd="rah run --cwd $(_shq "$cwd") --b64 $(printf '%s' "$cmd" | _b64_encode)" ;;
    *)
      newcmd="rah run --cwd $(_shq "$cwd") -- $cmd" ;;
  esac
  _hook_log_event "$tool" "$reported_cwd" "$tool_cwd" "$cwd" "$matched" "$cfg" \
    "route" "managed-mount" "$decision" "$decision" 1 "$cmd"
  jq -nc --arg c "$newcmd" --arg d "$decision" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:$d,updatedInput:{command:$c}}}'
}

cmd_hook_log() {
  local action="${1:-status}" path="${2:-}"
	  case "$action" in
	    on)
	      [ -n "$path" ] || path="$RAH_HOOK_LOG_DEFAULT"
	      mkdir -p "$RAH_CONFIG_DIR" "$(dirname "$path")"
	      printf '%s\n' "$path" > "$RAH_HOOK_LOG_FLAG"
	      : >> "$path" || _die "cannot write hook log: $path"
	      _say_ok "hook log enabled"
	      _say_note "$path"
	      ;;
	    off)
	      rm -f "$RAH_HOOK_LOG_FLAG"
	      _say_ok "hook log disabled"
	      ;;
	    status|path)
	      if path="$(_hook_log_path)"; then
	        _say_ok "hook log enabled"
	        _say_note "$path"
	      else
	        _say_note "hook log disabled"
	      fi
	      ;;
    clear)
      if [ -n "$path" ]; then
        :
      elif path="$(_hook_log_path 2>/dev/null)"; then
        :
      else
        path="$RAH_HOOK_LOG_DEFAULT"
	      fi
	      mkdir -p "$(dirname "$path")"
	      : > "$path" || _die "cannot clear hook log: $path"
	      _say_ok "hook log cleared"
	      _say_note "$path"
	      ;;
    *)
      _die "usage: rah hook-log on [path] | off | status | clear [path]"
      ;;
  esac
}

# ---------- autostart ----------

_autostart_interval() { printf '%s\n' "${RAH_AUTOSTART_INTERVAL:-300}"; }

_systemd_user_dir() { printf '%s/systemd/user\n' "${XDG_CONFIG_HOME:-$HOME/.config}"; }
_systemd_mount_template_path() { printf '%s/rah-mount@.service\n' "$(_systemd_user_dir)"; }
_systemd_legacy_service_path() { printf '%s/rah-remount.service\n' "$(_systemd_user_dir)"; }
_systemd_legacy_timer_path() { printf '%s/rah-remount.timer\n' "$(_systemd_user_dir)"; }

_systemd_user_ready() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1
}

_systemd_mount_unit_name() {
  command -v systemd-escape >/dev/null 2>&1 || return 1
  systemd-escape --template='rah-mount@.service' "$1"
}

_systemd_autostart_configured() {
  _is_macos && return 1
  [ -f "$(_systemd_mount_template_path)" ]
}

_systemd_mount_service_enabled() {
  local unit state
  _systemd_user_ready || return 1
  unit="$(_systemd_mount_unit_name "$1")" || return 1
  state="$(systemctl --user is-enabled "$unit" 2>/dev/null || true)"
  case "$state" in enabled|enabled-runtime|linked|linked-runtime) return 0 ;; esac
  return 1
}

_systemd_enable_mount_service() {
  local unit
  _systemd_user_ready || return 1
  unit="$(_systemd_mount_unit_name "$1")" || return 1
  systemctl --user enable --now "$unit"
}

_systemd_restart_mount_service() {
  local unit
  _systemd_user_ready || return 1
  unit="$(_systemd_mount_unit_name "$1")" || return 1
  systemctl --user restart "$unit"
}

_systemd_stop_mount_service() {
  local unit
  _is_macos && return 0
  _systemd_user_ready || return 0
  unit="$(_systemd_mount_unit_name "$1")" || return 0
  systemctl --user stop "$unit" >/dev/null 2>&1 || true
}

_systemd_disable_mount_service() {
  local unit
  _is_macos && return 0
  _systemd_user_ready || return 0
  unit="$(_systemd_mount_unit_name "$1")" || return 0
  systemctl --user disable "$unit" >/dev/null 2>&1 || true
}

# Commands used by the generated systemd template. Keep sshfs in the foreground
# so systemd owns the FUSE process rather than killing its background child when
# a oneshot remount command exits.
cmd_systemd_mount() {
  local name="${1:-}" cfg host remote_path mp socket port state
  [ -n "$name" ] || _die "internal: missing systemd mount name"
  cfg="$RAH_CONFIG_DIR/$name.env"
  [ -f "$cfg" ] || return 0
  host="$(_get "$cfg" host)"; remote_path="$(_get "$cfg" remote_path)"
  mp="$(_get "$cfg" mountpoint)"; socket="$(_get "$cfg" control_socket)"; port="$(_get "$cfg" ssh_port)"
  state="$(_mount_state "$mp")"
  # A mount already sitting here belongs to somebody else (a manual `rah mount`),
  # never to this service: ExecStart has to stay in the foreground for the unit to
  # own the sshfs lifecycle, so returning 0 would finish the service and fire
  # ExecStop, which unmounts the very mount we just found. Take it over instead.
  case "$state" in
    mounted|dead) _unmount_fuse "$mp" 2>/dev/null || true ;;
  esac
  mp="$(_prepare_mountpoint "$mp" 0)" || return 1
  _do_mount "$host" "$remote_path" "$mp" "$socket" "$port" 1
}

cmd_systemd_check() {
  local name="${1:-}" cfg mp
  [ -n "$name" ] || _die "internal: missing systemd mount name"
  cfg="$RAH_CONFIG_DIR/$name.env"
  [ -f "$cfg" ] || return 0
  mp="$(_get "$cfg" mountpoint)"
  _wait_for_mount "$mp" 10 || {
    echo "rah: systemd mount did not become ready: $name ($mp)" >&2
    return 1
  }
}

cmd_systemd_unmount() {
  local name="${1:-}" cfg mp state
  [ -n "$name" ] || return 0
  cfg="$RAH_CONFIG_DIR/$name.env"
  [ -f "$cfg" ] || return 0
  mp="$(_get "$cfg" mountpoint)"
  state="$(_mount_state "$mp")"
  case "$state" in
    mounted|dead) _unmount_fuse "$mp" >/dev/null 2>&1 || true ;;
  esac
}

_launchd_label() { printf 'dev.rah.remount\n'; }
_launchd_plist_path() { printf '%s/Library/LaunchAgents/%s.plist\n' "$HOME" "$(_launchd_label)"; }

_autostart_provider() {
  if _is_macos; then
    printf 'launchd\n'
  elif command -v systemctl >/dev/null 2>&1; then
    printf 'systemd\n'
  else
    printf 'unsupported\n'
  fi
}

_write_systemd_autostart() {
  local unit_dir template rah_bin
  unit_dir="$(_systemd_user_dir)"
  template="$(_systemd_mount_template_path)"
  _ensure_path
  rah_bin="$RAH_BIN_DIR/rah"
  mkdir -p "$unit_dir" "$RAH_CONFIG_DIR"
  cat > "$template" <<EOF
[Unit]
Description=Keep RAH mount %I available
Documentation=https://github.com/$RAH_REPO
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=$RAH_BIN_DIR:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=$(_unit_quote "$rah_bin") _systemd-mount %I
ExecStartPost=$(_unit_quote "$rah_bin") _systemd-check %I
ExecStop=$(_unit_quote "$rah_bin") _systemd-unmount %I
Restart=on-failure
RestartSec=15s
TimeoutStartSec=30s
TimeoutStopSec=20s

[Install]
WantedBy=default.target
EOF
}

_disable_legacy_systemd_autostart() {
  if _systemd_user_ready; then
    systemctl --user disable --now rah-remount.timer >/dev/null 2>&1 || true
    systemctl --user stop rah-remount.service >/dev/null 2>&1 || true
  fi
  rm -f "$(_systemd_legacy_service_path)" "$(_systemd_legacy_timer_path)"
}

_autostart_enable_systemd() {
  local cfg name enabled=0 failed=0
  _write_systemd_autostart
  _say_ok "installed systemd user units"
  _say_note "$(_systemd_mount_template_path)"
  if systemctl --user daemon-reload >/dev/null 2>&1; then
    _disable_legacy_systemd_autostart
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    while IFS= read -r cfg; do
      [ -n "$cfg" ] || continue
      name="$(basename "$cfg" .env)"
      if _systemd_enable_mount_service "$name" >/dev/null 2>&1; then
        enabled=$((enabled + 1))
      else
        _say_warn "could not enable automatic recovery for $name"
        failed=1
      fi
    done < <(_list_configs)
    if [ "$enabled" -gt 0 ]; then
      _say_ok "automatic recovery enabled for $enabled mount(s)"
    else
      _say_warn "no managed mounts to enable yet; future rah mount commands will be added automatically"
    fi
    if command -v loginctl >/dev/null 2>&1 &&
       [ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || true)" = no ]; then
      _say_note "to remount before your first login after boot, run: sudo loginctl enable-linger $USER"
    fi
    return "$failed"
  else
    _say_warn "systemd --user is not available or could not enable the timer"
    _say_cmd "systemctl --user daemon-reload"
    _say_cmd "rah autostart on"
    return 1
  fi
}

_autostart_disable_systemd() {
  local cfg name
  while IFS= read -r cfg; do
    [ -n "$cfg" ] || continue
    name="$(basename "$cfg" .env)"
    _systemd_disable_mount_service "$name"
  done < <(_list_configs)
  _disable_legacy_systemd_autostart
  rm -f "$(_systemd_mount_template_path)"
  _systemd_user_ready && systemctl --user daemon-reload >/dev/null 2>&1 || true
  _say_ok "autostart disabled"
}

_autostart_status_systemd() {
  local template cfg name unit enabled=0 active=0 total=0
  template="$(_systemd_mount_template_path)"
  printf '  %-10s systemd --user\n' "provider:"
  if [ -f "$template" ]; then
    printf '  %-10s ' "files:"
    _tag_ok "installed"; printf ' %s\n' "$template"
  else
    printf '  %-10s ' "files:"
    _tag_note "not installed"; printf ' run: rah autostart on\n'
  fi
  if _systemd_user_ready; then
    while IFS= read -r cfg; do
      [ -n "$cfg" ] || continue
      total=$((total + 1)); name="$(basename "$cfg" .env)"
      unit="$(_systemd_mount_unit_name "$name" 2>/dev/null || true)"
      [ -n "$unit" ] || continue
      _systemd_mount_service_enabled "$name" && enabled=$((enabled + 1))
      [ "$(systemctl --user is-active "$unit" 2>/dev/null || true)" = active ] && active=$((active + 1))
    done < <(_list_configs)
    printf '  %-10s %s/%s enabled, %s active\n' "mounts:" "$enabled" "$total" "$active"
  else
    printf '  %-10s ' "mounts:"
    _tag_warn "unavailable"; printf ' systemd --user is not reachable\n'
  fi
}

_write_launchd_autostart() {
  local plist label rah_bin interval out_log err_log
  plist="$(_launchd_plist_path)"
  label="$(_launchd_label)"
  interval="$(_autostart_interval)"
  _ensure_path
  rah_bin="$RAH_BIN_DIR/rah"
  mkdir -p "$HOME/Library/LaunchAgents" "$RAH_CONFIG_DIR"
  out_log="$RAH_CONFIG_DIR/autostart.out.log"
  err_log="$RAH_CONFIG_DIR/autostart.err.log"
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(_xml_escape "$label")</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(_xml_escape "$rah_bin")</string>
    <string>remount</string>
    <string>--best-effort</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>$interval</integer>
  <key>StandardOutPath</key>
  <string>$(_xml_escape "$out_log")</string>
  <key>StandardErrorPath</key>
  <string>$(_xml_escape "$err_log")</string>
</dict>
</plist>
EOF
}

_autostart_enable_launchd() {
  local plist label domain service
  _write_launchd_autostart
  plist="$(_launchd_plist_path)"
  label="$(_launchd_label)"
  domain="gui/$(id -u)"
  service="$domain/$label"
  _say_ok "installed launchd agent"
  _say_note "$plist"
  if launchctl bootout "$service" >/dev/null 2>&1; then :; fi
  if launchctl bootstrap "$domain" "$plist" >/dev/null 2>&1; then
    launchctl enable "$service" >/dev/null 2>&1 || true
    launchctl kickstart -k "$service" >/dev/null 2>&1 || true
    _say_ok "autostart enabled"
  elif launchctl load -w "$plist" >/dev/null 2>&1; then
    _say_ok "autostart enabled"
  else
    _say_warn "launchd could not load the agent"
    _say_cmd "launchctl bootstrap $domain $(_shq "$plist")"
    return 1
  fi
}

_autostart_disable_launchd() {
  local plist label service
  plist="$(_launchd_plist_path)"
  label="$(_launchd_label)"
  service="gui/$(id -u)/$label"
  launchctl bootout "$service" >/dev/null 2>&1 || launchctl unload -w "$plist" >/dev/null 2>&1 || true
  rm -f "$plist"
  _say_ok "autostart disabled"
}

_autostart_status_launchd() {
  local plist label service
  plist="$(_launchd_plist_path)"
  label="$(_launchd_label)"
  service="gui/$(id -u)/$label"
  printf '  %-10s launchd\n' "provider:"
  if [ -f "$plist" ]; then
    printf '  %-10s ' "plist:"
    _tag_ok "installed"; printf ' %s\n' "$plist"
  else
    printf '  %-10s ' "plist:"
    _tag_note "not installed"; printf ' run: rah autostart on\n'
  fi
  printf '  %-10s ' "agent:"
  if launchctl print "$service" >/dev/null 2>&1; then
    _tag_ok "loaded"; printf '\n'
  else
    _tag_warn "not loaded"; printf '\n'
  fi
}

_autostart_print_status() {
  case "$(_autostart_provider)" in
    systemd) _autostart_status_systemd ;;
    launchd) _autostart_status_launchd ;;
    *)       printf '  %-10s ' "provider:"; _tag_warn "unsupported"; printf ' needs systemd --user or macOS launchd\n' ;;
  esac
}

cmd_autostart() {
  local action="${1:-status}"
  [ $# -le 1 ] || _die "usage: rah autostart on|off|status"
  case "$action" in
    on|enable)
      case "$(_autostart_provider)" in
        systemd) _autostart_enable_systemd ;;
        launchd) _autostart_enable_launchd ;;
        *) _die "autostart needs systemd --user on Linux or launchd on macOS" ;;
      esac ;;
    off|disable)
      case "$(_autostart_provider)" in
        systemd) _autostart_disable_systemd ;;
        launchd) _autostart_disable_launchd ;;
        *) _say_warn "autostart unsupported on this platform" ;;
      esac ;;
    status)
      _say_header "rah autostart"
      _autostart_print_status ;;
    *)
      _die "usage: rah autostart on|off|status" ;;
  esac
}

# ---------- init (install/remove hook + skill for an agent) ----------

_ensure_path() {
  mkdir -p "$RAH_BIN_DIR"
	  local self target="$RAH_BIN_DIR/rah"; self="$(_self_path)"
	  [ "$self" = "$target" ] || ln -sf "$self" "$target"
	  case ":$PATH:" in
	    *":$RAH_BIN_DIR:"*) ;;
	    *) _say_warn "add $RAH_BIN_DIR to your PATH" ;;
	  esac
	}

# True if the rah hook is already registered in a JSON agent config file.
_hook_present() {
  local file="$1"
  [ -f "$file" ] || return 1
  jq -e '(.hooks.PreToolUse // []) | any(.[]; (.hooks // []) | any(.command | startswith("rah hook")))' \
    "$file" >/dev/null 2>&1
}

# Add/update our {matcher:"Bash", hooks:[{command:<hc>}]} group in .hooks.PreToolUse, idempotently.
_merge_hook_json() {
  local file="$1" hc="$2" matcher="$3" tmp; tmp="$(mktemp)"
  [ -f "$file" ] || echo '{}' > "$file"
  jq --arg hc "$hc" --arg matcher "$matcher" '
    .hooks.PreToolUse = ((.hooks.PreToolUse // [])
      | map(if ((.hooks // []) | any(.command | startswith("rah hook"))) then
          .matcher = $matcher
          | .hooks |= map(if (.command | startswith("rah hook")) then .command = $hc else . end)
        else . end)
      | if any(.[]; (.hooks // []) | any(.command | startswith("rah hook"))) then .
        else . + [{matcher:$matcher, hooks:[{type:"command", command:$hc}]}] end)
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

# Strip the rah hook entry from .hooks.PreToolUse, dropping any group left empty.
_remove_hook_json() {
  local file="$1" tmp
  [ -f "$file" ] || return 0
  tmp="$(mktemp)"
  jq '
    if (.hooks.PreToolUse | type) == "array" then
      .hooks.PreToolUse |= ( map(.hooks |= map(select((.command | startswith("rah hook")) | not)))
                             | map(select((.hooks // [] | length) > 0)) )
    else . end
  ' "$file" > "$tmp" && mv "$tmp" "$file"
}

_init_agent() {
  local label="$1" home="$2" cfg="$3" skilldir="$4" remove="$5" hookcmd="$6" matcher="$7"
	  if [ "$remove" -eq 1 ]; then
	    _remove_hook_json "$cfg"
	    rm -rf "$skilldir"
	    _say_ok "removed $label hook + skill"
	  else
	    _ensure_path
	    mkdir -p "$home" "$skilldir"
	    _merge_hook_json "$cfg" "$hookcmd" "$matcher"
	    _skill_doc > "$skilldir/SKILL.md"
	    _say_ok "$label hook + skill installed"
	    _say_note "$home"
	  fi
	}

cmd_init() {
  local agent="" remove=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --remove)     remove=1; shift ;;
      claude|codex) agent="$1"; shift ;;
      *)            _die "usage: rah init <claude|codex> [--remove]" ;;
    esac
  done
  case "$agent" in
    claude) _init_agent "Claude" "$HOME/.claude" "$HOME/.claude/settings.json" "$HOME/.claude/skills/rah" "$remove" "rah hook --decision allow" "Bash" ;;
    codex)  _init_agent "Codex"  "$HOME/.codex"  "$HOME/.codex/hooks.json"     "$HOME/.codex/skills/rah"  "$remove" "rah hook --decision allow --passthrough empty" "Bash|command_execution" ;;
    *)      _die "usage: rah init <claude|codex> [--remove]" ;;
  esac
}

# ---------- setup (one-command guided onboarding) ----------

cmd_setup() {
  local target="" local_arg="" prelude="" prelude_set=0 port="" same_path=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --prelude) prelude="$2"; prelude_set=1; shift 2 ;;
      -y|--yes)  RAH_YES=1; shift ;;
      --local)   local_arg="$2"; shift 2 ;;
      --port)    port="$2"; shift 2 ;;
      --same-path) same_path=1; shift ;;
      --*)       _die "unknown option: $1" ;;
      *)
        if [ -z "$target" ]; then
          target="$1"
        elif [ -z "$local_arg" ]; then
          local_arg="$1"
        else
          _die "too many arguments: $1"
        fi
        shift ;;
    esac
	  done
	  [ "$same_path" -eq 0 ] || [ -z "$local_arg" ] || _die "--same-path cannot be combined with a local path"

	  _say_header "rah setup"
	  local setup_state
	  setup_state="$(mktemp)"
	  _setup_collect_target "$target" "$port" "$setup_state"
	  target="$(_get "$setup_state" target)"
	  port="$(_get "$setup_state" port)"
	  rm -f "$setup_state"

	  # 1) Dependencies — in a terminal, offer to install the missing ones.
	  _say_header "Dependencies"
	  local missing; missing="$(_missing_pkgs)"
	  if [ -n "$missing" ]; then
	    _say_warn "missing packages: $missing"
	    while IFS= read -r line; do [ -n "$line" ] && _say_cmd "$line"; done < <(_dep_install_hints "$missing")
	    if _can_auto_install_deps && _confirm "install them now?"; then
	      _install_missing_deps "$missing" || _die "dependency install failed"
	      missing="$(_missing_pkgs)"; [ -z "$missing" ] || _die "still missing: $missing"
	    else
	      _can_auto_install_deps || _say_warn "automatic dependency install needs apt-get on Linux, or Homebrew/MacPorts on macOS"
	      _die "install these packages first: $missing"
	    fi
	  fi
	  _say_ok "all required commands are available"

	  # 2) Wire whichever agents are installed (idempotent); note if a hook was newly added.
	  _say_header "Agent hooks"
	  local a adir cfgfile newly=0 agents_seen=0
	  for a in claude codex; do
	    adir="$HOME/.$a"; [ -d "$adir" ] || continue
	    agents_seen=1
	    cfgfile="$adir/settings.json"; [ "$a" = codex ] && cfgfile="$adir/hooks.json"
	    _hook_present "$cfgfile" || newly=1
	    cmd_init "$a" >/dev/null
	    _say_ok "$a hook + skill wired"
	  done
	  [ "$agents_seen" -eq 1 ] || _say_warn "no Claude/Codex config directory found yet; run 'rah init claude' or 'rah init codex' after installing the agent"

	  # 3) Remote target. host may be an ~/.ssh/config alias; Port/ProxyJump live in
	  #    ssh_config and are inherited by both ssh and sshfs (see "Remote behind NAT").
	  local host="${target%%:*}" remote_raw="${target#*:}" remote_path=""

	  # 4) SSH must be passwordless. In a terminal, offer to generate + authorize a key;
	  #    otherwise (e.g. an agent invoked us) print the one human step and stop.
	  _say_header "SSH"
	  if ! _ssh_ok "$host" "$port"; then
	    _say_warn "ssh preflight for '$host${port:+:$port}' failed"
	    _ssh_failure_details "$host" "$port" | sed 's/^/  ssh: /'
	    if _interactive; then
	      if ! ls "$HOME"/.ssh/id_*.pub >/dev/null 2>&1; then
	        if _confirm "no ssh key found — generate one (ssh-keygen ed25519)?"; then
	          ssh-keygen -t ed25519 -f "$HOME/.ssh/id_ed25519"
        fi
	      fi
	      if _confirm "authorize your key on $host now? (you'll enter the remote password once)"; then
	        _authorize_ssh_key "$host" "$port" || true
	      fi
	      _ssh_ok "$host" "$port" || { _say_fail "still cannot use non-interactive ssh to $host"; _say_cmd "rah setup $target"; _suggest_nat_traversal; return 1; }
	    else
	      if [ -n "$port" ]; then
	        _say_cmd "ssh -p $port -o BatchMode=yes -o ConnectTimeout=5 $host true"
	      else
	        _say_cmd "ssh -o BatchMode=yes -o ConnectTimeout=5 $host true"
	      fi
	      _say_note "if you normally use an ssh alias, use that alias in the rah target."
	      _suggest_nat_traversal
	      return 1
	    fi
	  fi
	  _say_ok "passwordless ssh works: $host${port:+:$port}"

  if ! remote_path="$(_resolve_remote_path "$host" "$remote_raw" "$port")"; then
    _die "remote path must be absolute or ~/relative: $remote_raw"
  fi
  remote_path="$(_trim_trailing_slashes "$remote_path")"

  # 5) Local mountpoint. Default setup uses ~/mnt_rah/<project>;
  # use --same-path only when identical local/remote absolute paths are intentional.
  local mountpoint default_local ans="" default_name cfg cfg_host cfg_remote cfg_port
  if [ "$same_path" -eq 1 ]; then
    local_arg="$remote_path"
  elif [ -z "$local_arg" ]; then
    default_name="$(_default_mount_name "$host" "$remote_path")"
    cfg="$RAH_CONFIG_DIR/$default_name.env"
    if [ -f "$cfg" ]; then
      cfg_host="$(_get "$cfg" host)"
      cfg_remote="$(_get "$cfg" remote_path)"
      cfg_port="$(_get "$cfg" ssh_port)"
      if [ "$cfg_host" = "$host" ] && [ "$cfg_remote" = "$remote_path" ] && [ "$cfg_port" = "$port" ]; then
        default_local="$(_get "$cfg" mountpoint)"
      fi
    fi
    [ -n "$default_local" ] || default_local="$(_default_mountpoint "$host" "$remote_path")"
    if _interactive; then
      ans="$(_prompt "local mount directory [$default_local]: ")"
      local_arg="${ans:-$default_local}"
    else
      local_arg="$default_local"
    fi
	  fi
	  mountpoint="$(_expand_local_path "$local_arg")"
	  _say_header "Mount plan"
	  _say_cmd "$(_setup_command_preview "$port" "$target" "$mountpoint" "$same_path" "$prelude_set" "$prelude")"
	  _say_note "remote: $host:$remote_path${port:+ port $port}"
	  _say_note "local:  $mountpoint"
	  if ! mountpoint="$(_prepare_mountpoint "$mountpoint" 1)"; then
	    _say_cmd "rah setup $target $local_arg"
	    return 1
	  fi

	  # 6) Best-effort prelude auto-probe.
	  if [ "$prelude_set" = 0 ]; then
    local socket="$(_socket_for_host "$host" "$port")" ssh_args=()
	    [ -n "$port" ] && ssh_args=(-p "$port")
	    _ensure_master "$host" "$socket" "$port" 2>/dev/null || true
	    if ssh "${ssh_args[@]}" -S "$socket" "$host" "test -f $(_shq "$remote_path/.venv/bin/activate")" 2>/dev/null; then
	      prelude="source .venv/bin/activate"
	      _say_ok "detected .venv prelude"
	      _say_note "$prelude"
	    fi
	  fi

	  # 7) Mount + finish.
	  _say_header "Mount"
	  if [ -n "$prelude" ]; then
	    if [ -n "$port" ]; then cmd_mount --port "$port" --prelude "$prelude" "$target" "$mountpoint"; else cmd_mount --prelude "$prelude" "$target" "$mountpoint"; fi
	  else
	    if [ -n "$port" ]; then cmd_mount --port "$port" "$target" "$mountpoint"; else cmd_mount "$target" "$mountpoint"; fi
	  fi
	  echo
	  if [ "$newly" = 1 ]; then
	    _say_warn "hook newly installed; restart your agent once so it loads"
	    _say_note "future mounts activate immediately, no restart needed."
	  else
	    _say_ok "routing is live now; no restart needed"
	  fi
	  echo
	  _say_header "Next"
	  _say_cmd "cd $mountpoint"
	  _say_cmd "rah verify"
	  _say_cmd "codex   # or: claude"
	  _say_note "then ask the agent to run: nvidia-smi"
	}

# ---------- status / doctor ----------

_agent_hook_status() {
  local label="$1" cfg="$2" expected_cmd="$3" expected_matcher="$4"
  local agent
  agent="$(_lower "$label")"
  printf '  %-10s ' "$label"
  if [ ! -f "$cfg" ]; then
    printf '%b\n' "$(_tag_warn "not installed") run: rah init $agent"
    return 1
  fi
  if jq -e --arg cmd "$expected_cmd" --arg matcher "$expected_matcher" '
      (.hooks.PreToolUse // [])
      | any(.[]; (.matcher // "") == $matcher and ((.hooks // []) | any(.command == $cmd)))
    ' "$cfg" >/dev/null 2>&1; then
    printf '%b\n' "$(_tag_ok "installed")"
    return 0
  fi
  if _hook_present "$cfg"; then
    printf '%b\n' "$(_tag_warn "needs update") run: rah init $agent"
  else
    printf '%b\n' "$(_tag_fail "missing") run: rah init $agent"
  fi
  return 1
}

_cfg_from_arg_or_cwd() {
  local arg="${1:-}" cfg="" count=0 last="" local_arg=""
  if [ -n "$arg" ]; then
    if [ -f "$RAH_CONFIG_DIR/$arg.env" ]; then
      printf '%s\n' "$RAH_CONFIG_DIR/$arg.env"; return 0
    fi
    if cfg="$(_config_for_cwd "$arg" 2>/dev/null)"; then
      printf '%s\n' "$cfg"; return 0
    fi
    local_arg="$(_expand_local_path "$arg")"
    if cfg="$(_config_for_cwd "$local_arg" 2>/dev/null)"; then
      printf '%s\n' "$cfg"; return 0
    fi
    return 1
  fi

  if cfg="$(_config_for_cwd "$PWD" 2>/dev/null)"; then
    printf '%s\n' "$cfg"; return 0
  fi
  while IFS= read -r cfg; do
    [ -n "$cfg" ] || continue
    count=$((count + 1)); last="$cfg"
  done < <(_list_configs)
  [ "$count" -eq 1 ] && { printf '%s\n' "$last"; return 0; }
  return 1
}

_exec_plane_ok() {
  local mp="$1"
  _timeout 15 "$(_self_path)" run --cwd "$mp" -- true >/dev/null 2>&1
}

cmd_status() {
  local scope="all" target="" show_agents=1 configs=() any=0 cfg name host remote_path mp socket state mode port current_cfg="" mount_header=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--all) scope="all"; shift ;;
      -c|--current) scope="current"; shift ;;
      --no-agents) show_agents=0; shift ;;
      --*) _die "usage: rah status [--all|--current] [--no-agents] [name|path]" ;;
      *)
        [ -z "$target" ] || _die "usage: rah status [--all|--current] [--no-agents] [name|path]"
        target="$1"; shift ;;
    esac
  done

  _say_header "rah status (v$RAH_VERSION)"

  if cfg="$(_config_for_cwd "$PWD" 2>/dev/null)"; then
    current_cfg="$cfg"
  fi

  if [ -n "$target" ]; then
    if cfg="$(_cfg_from_arg_or_cwd "$target")"; then
      configs+=("$cfg")
    else
      _die "no such mount: $target"
    fi
  elif [ "$scope" = current ]; then
    if [ -n "$current_cfg" ]; then
      configs+=("$current_cfg")
    else
      _say_warn "current directory is not inside a rah-managed mount"
    fi
  else
    while IFS= read -r cfg; do [ -n "$cfg" ] && configs+=("$cfg"); done < <(_list_configs)
  fi

  if [ -n "$target" ]; then
    mount_header="Mounts (selected)"
  elif [ "$scope" = current ]; then
    mount_header="Mounts (current cwd)"
  else
    mount_header="Mounts (all managed configs)"
  fi
  _say_header "$mount_header"
  _say_note "config dir: $RAH_CONFIG_DIR"
  for cfg in "${configs[@]}"; do
    any=1
    name="$(basename "$cfg" .env)"
    host="$(_get "$cfg" host)"; remote_path="$(_get "$cfg" remote_path)"
    mp="$(_get "$cfg" mountpoint)"; socket="$(_get "$cfg" control_socket)"; port="$(_get "$cfg" ssh_port)"
    mode="$(_get "$cfg" mode)"; [ -n "$mode" ] || mode="same-path"
    printf '%b\n' "${RAH_BOLD}$name${RAH_RESET}"
    printf '  host:       %s\n' "$host"
    [ -n "$port" ] && printf '  port:       %s\n' "$port"
    printf '  remote:     %s\n' "$remote_path"
    printf '  local:      %s [%s] ' "$mp" "$mode"
    state="$(_mount_state "$mp")"
    case "$state" in
      mounted) _tag_ok "mounted"; printf '\n' ;;
      dead)    _tag_fail "DEAD"; printf ' run: rah remount %s\n' "$name" ;;
      *)       _tag_warn "not mounted"; printf '\n' ;;
    esac
    printf '  ssh:        '
    if _ssh_ok "$host" "$port"; then _tag_ok "reachable"; printf '\n'; else _tag_fail "FAILED"; printf ' run: ssh%s -o BatchMode=yes %s true\n' "${port:+ -p $port}" "$host"; fi
    printf '  exec:       '
    if _exec_plane_ok "$mp"; then _tag_ok "remote ok"; printf '\n'; else _tag_fail "FAILED"; printf ' run: rah verify %s\n' "$name"; fi
    if [ "$cfg" = "$current_cfg" ]; then
      printf '  current:    yes\n'
    fi
  done
  [ "$any" -eq 1 ] || [ "$scope" = current ] || _say_warn "no managed mounts; run: rah mount user@host:~/project"

  _say_header "Autostart"
  _autostart_print_status || true

  if [ "$show_agents" -eq 1 ]; then
    _say_header "Agents"
    _agent_hook_status "claude" "$HOME/.claude/settings.json" "rah hook --decision allow" "Bash" || true
    _agent_hook_status "codex" "$HOME/.codex/hooks.json" "rah hook --decision allow --passthrough empty" "Bash|command_execution" || true
    printf '  %-10s ' "hook-log"
    if _hook_log_path >/dev/null 2>&1; then
      printf '%b\n' "$(_tag_ok "on") run: rah hook-log off"
    else
      printf '%b\n' "$(_tag_note "off")"
    fi
  fi
}

cmd_verify() {
  local target="${1:-}" cfg name host remote_path mp port ok=1 out hook_out outside path_cmd path_b64
  if ! cfg="$(_cfg_from_arg_or_cwd "$target")"; then
    _die "verify: no target mount found (run inside a mount, or: rah verify <name|path>)"
  fi
  name="$(basename "$cfg" .env)"
  host="$(_get "$cfg" host)"; remote_path="$(_get "$cfg" remote_path)"; mp="$(_get "$cfg" mountpoint)"; port="$(_get "$cfg" ssh_port)"

  _say_header "rah verify (v$RAH_VERSION) - $name"
  printf '  deps:       '
  if [ -z "$(_missing_pkgs)" ]; then _tag_ok "ok"; printf '\n'; else _tag_fail "MISSING"; printf ' run: rah doctor\n'; ok=0; fi

  printf '  mount:      '
  case "$(_mount_state "$mp")" in
    mounted) _tag_ok "mounted"; printf ' %s\n' "$mp" ;;
    dead)    _tag_fail "DEAD"; printf ' run: rah remount %s\n' "$name"; ok=0 ;;
    *)       _tag_warn "not mounted"; printf ' run: rah remount %s\n' "$name"; ok=0 ;;
  esac

  printf '  ssh:        '
  if _ssh_ok "$host" "$port"; then
    _tag_ok "reachable"
    if [ -n "$port" ]; then printf ' %s:%s\n' "$host" "$port"; else printf ' %s\n' "$host"; fi
  else
    _tag_fail "FAILED"; printf ' run: ssh%s -o BatchMode=yes %s true\n' "${port:+ -p $port}" "$host"
    ok=0
  fi

  printf '  exec:       '
  if out="$(_timeout 15 "$(_self_path)" run --cwd "$mp" -- pwd 2>/dev/null)" && [ "$out" = "$remote_path" ]; then
    _tag_ok "remote ok"; printf '\n'
  else
    _tag_fail "FAILED"; printf ' explicit rah run did not cd to %s\n' "$remote_path"
    ok=0
  fi

  printf '  path map:   '
  path_cmd="printf %s $(_shq "$mp")"
  path_b64="$(printf '%s' "$path_cmd" | _b64_encode)"
  if out="$(_timeout 15 "$(_self_path)" run --cwd "$mp" --b64 "$path_b64" 2>/dev/null)" && [ "$out" = "$remote_path" ]; then
    _tag_ok "ok"; printf '\n'
  else
    _tag_fail "FAILED"; printf ' local absolute path was not translated\n'
    ok=0
  fi

  printf '  hook route: '
  hook_out="$(jq -nc --arg cwd "$mp" --arg cmd "printf rah-hook-ok" \
      '{tool_name:"Bash",cwd:$cwd,tool_input:{command:$cmd}}' \
	    | "$(_self_path)" hook --decision allow --passthrough empty 2>/dev/null)"
  if printf '%s' "$hook_out" | jq -e '.hookSpecificOutput.permissionDecision == "allow" and (.hookSpecificOutput.updatedInput.command | startswith("rah run --cwd "))' >/dev/null 2>&1; then
    _tag_ok "ok"; printf '\n'
  else
    _tag_fail "FAILED"; printf ' hook did not rewrite a managed cwd\n'
    ok=0
  fi

  printf '  codex pass: '
  outside="$(mktemp -d)"
  hook_out="$(jq -nc --arg cwd "$outside" --arg cmd "printf local-ok" \
      '{tool_name:"Bash",cwd:$cwd,tool_input:{command:$cmd}}' \
	    | "$(_self_path)" hook --decision allow --passthrough empty 2>/dev/null)"
  rmdir "$outside" 2>/dev/null || true
  if [ -z "$hook_out" ]; then _tag_ok "ok"; printf '\n'; else _tag_fail "FAILED"; printf ' Codex passthrough was not empty\n'; ok=0; fi

  printf '  claude:     '
  if _agent_hook_status "claude" "$HOME/.claude/settings.json" "rah hook --decision allow" "Bash" >/dev/null; then
    _tag_ok "hook installed"; printf '\n'
  else
    _tag_warn "not ready"; printf ' run: rah init claude\n'
    ok=0
  fi

  printf '  codex:      '
  if _agent_hook_status "codex" "$HOME/.codex/hooks.json" "rah hook --decision allow --passthrough empty" "Bash|command_execution" >/dev/null; then
    _tag_ok "hook installed"; printf '\n'
  else
    _tag_warn "not ready"; printf ' run: rah init codex\n'
    ok=0
  fi

  if [ "$ok" -eq 1 ]; then
    _say_ok "verify passed"
  else
    _say_fail "verify found issues"
    return 1
  fi
}

_check_dep() {  # name pkg required(0|1) ; prints status, returns non-zero if missing
  local bin="$1" pkg="$2" required="$3"
  printf '  %-12s ' "$bin"
  if command -v "$bin" >/dev/null 2>&1; then _tag_ok "ok"; printf '\n'; return 0; fi
  if _is_macos && [ "$bin" = sshfs ]; then
    local sshfs_path
    if sshfs_path="$(_find_sshfs 2>/dev/null)"; then
      _tag_ok "ok"; printf ' %s\n' "$sshfs_path"
      return 0
    fi
  fi
  if [ "$required" -eq 1 ]; then
    _tag_fail "MISSING"; printf ' %s\n' "$(_pkg_install_note "$pkg")"
  else
    _tag_warn "optional"; printf ' %s\n' "$(_pkg_install_note "$pkg")"
  fi
  return 1
}

cmd_doctor() {
  local ok=1 d
  _say_header "rah doctor (v$RAH_VERSION)"
  for d in "${RAH_DEPS[@]}"; do _check_dep "${d%%:*}" "${d#*:}" 1 || ok=0; done
  if ! _is_macos; then
    if command -v fusermount >/dev/null 2>&1 || command -v fusermount3 >/dev/null 2>&1; then
      printf '  %-12s ' fusermount; _tag_ok "ok"; printf '\n'
    else
      printf '  %-12s ' fusermount; _tag_fail "MISSING"; printf ' %s\n' "$(_pkg_install_note fuse3)"; ok=0
    fi
  fi
  _check_dep curl       curl           0 || true
  printf '  %-12s ' tailscale
  if command -v tailscale >/dev/null 2>&1; then
    _tag_ok "ok"; printf '\n'
  else
    _tag_note "optional"; printf ' for a remote behind NAT — see "Remote behind NAT" in the README\n'
  fi
  printf '  %-12s ' PATH
  case ":$PATH:" in
    *":$RAH_BIN_DIR:"*) _tag_ok "$RAH_BIN_DIR on PATH"; printf '\n' ;;
    *) _tag_warn "$RAH_BIN_DIR NOT on PATH"; printf ' add it\n' ;;
  esac
  local any=0 cfg
  while IFS= read -r cfg; do [ -n "$cfg" ] && any=1; done < <(_list_configs)
  [ "$any" -eq 1 ] && { _say_header "Mounts"; cmd_status | sed 's/^/  /'; }
  [ "$ok" -eq 1 ] && _say_ok "all required dependencies present" || _die "missing required dependencies (see above)"
}

# ---------- self-update / uninstall ----------

cmd_self_update() {
  command -v curl >/dev/null 2>&1 || _die "curl required for self-update"
  local dest tmp newver; dest="$(_self_path)"; tmp="$(mktemp)"
  _say_header "Self-update"
  _say_note "fetching $RAH_RAW_URL"
  curl -fsSL "$RAH_RAW_URL" -o "$tmp" || { rm -f "$tmp"; _die "download failed"; }
  head -1 "$tmp" | grep -q '^#!/usr/bin/env bash' || { rm -f "$tmp"; _die "downloaded file does not look like rah"; }
  newver="$(sed -n 's/^RAH_VERSION="\(.*\)"/\1/p' "$tmp" | head -1)"
  [ -n "$newver" ] || { rm -f "$tmp"; _die "downloaded file missing version marker"; }
  chmod +x "$tmp"; mv "$tmp" "$dest"
  _say_ok "updated $dest"
  _say_note "$RAH_VERSION -> $newver"
}

cmd_uninstall() {
  local purge=0
  case "${1:-}" in --purge) purge=1 ;; "") ;; *) _die "usage: rah uninstall [--purge]" ;; esac
  local cfg name
  while IFS= read -r cfg; do
    [ -n "$cfg" ] || continue
    name="$(basename "$cfg" .env)"
    cmd_unmount "$name" 2>/dev/null || true
	  done < <(_list_configs)
	  _remove_hook_json "$HOME/.claude/settings.json"; rm -rf "$HOME/.claude/skills/rah"
	  _remove_hook_json "$HOME/.codex/hooks.json";     rm -rf "$HOME/.codex/skills/rah"
	  _say_ok "removed hooks + skills from ~/.claude and ~/.codex"
	  [ -e "$RAH_BIN_DIR/rah" ] && { rm -f "$RAH_BIN_DIR/rah"; _say_ok "removed $RAH_BIN_DIR/rah"; }
	  if [ "$purge" -eq 1 ]; then
	    rm -rf "$RAH_CONFIG_DIR"; _say_ok "purged $RAH_CONFIG_DIR"
	  else
	    _say_note "kept configs in $RAH_CONFIG_DIR (use --purge to remove)"
	  fi
	}

# ---------- dispatch ----------

_usage() {
  cat <<EOF
rah — Remote as Host (v$RAH_VERSION)

  rah setup [--port PORT] [user@host:/path] [local-path] [--prelude CMD] [-y]
                                                               guided onboarding (deps/ssh/agent/mount)
  rah mount [--name N] [--port PORT] [--prelude CMD] user@host:/path [local-path]
                                                               mount remote code tree locally
  rah mount --same-path user@host:/abs/path                    use identical local/remote path mode
  rah remount [--force] [name|path]                          recover dead/unmounted mounts (all if no target)
  rah unmount <name|path>                                    unmount + drop ssh master, keep config
  rah remove [--keep-local] [name|path]                      unmount + remove config; rmdir empty mountpoint
  rah autostart on|off|status                                restore managed mounts after reboot/login
  rah run --cwd <dir> -- <cmd...>                            execute a command on the remote
  rah hook [--decision defer|allow|ask] [--passthrough defer|empty]
                                                                PreToolUse rewrite (reads JSON on stdin)
  rah hook-log on [path] | off | status | clear [path]       enable/inspect hook diagnostics
  rah init <claude|codex> [--remove]                         install/remove hook + skill for an agent
  rah status [--all|--current] [name|path] | list            show mount / ssh / exec / agent-hook health
  rah verify [name|path]                                     end-to-end mount/ssh/hook check
  rah doctor                                                 check dependencies, PATH, mount health
  rah self-update                                            update rah to the latest version
  rah uninstall [--purge]                                    remove hooks, skill, and the rah binary
  rah version                                                print version
EOF
}

main() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift || true
  case "$sub" in
    setup)       cmd_setup "$@" ;;
    mount)       cmd_mount "$@" ;;
    remount)     cmd_remount "$@" ;;
    unmount)     cmd_unmount "$@" ;;
    remove|rm)   cmd_remove "$@" ;;
    autostart)   cmd_autostart "$@" ;;
    run)         cmd_run "$@" ;;
    hook)        cmd_hook "$@" ;;
    hook-log)    cmd_hook_log "$@" ;;
    init)        cmd_init "$@" ;;
    status|list) cmd_status "$@" ;;
    verify)      cmd_verify "$@" ;;
    doctor)      cmd_doctor "$@" ;;
    self-update) cmd_self_update "$@" ;;
    uninstall)   cmd_uninstall "$@" ;;
    _systemd-mount)   cmd_systemd_mount "$@" ;;
    _systemd-check)   cmd_systemd_check "$@" ;;
    _systemd-unmount) cmd_systemd_unmount "$@" ;;
    version|--version|-v) echo "rah $RAH_VERSION" ;;
    ""|-h|--help|help) _usage ;;
    *) _die "unknown subcommand: $sub (try: rah help)" ;;
  esac
}

main "$@"
